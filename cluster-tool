def kubelet_sign_script(role, ip, signer_dir):
    """Build the script that signs one kubelet client and server certificate."""
    return textwrap.dedent(f"""\
        set -euo pipefail
        openssl ecparam -name prime256v1 -genkey -out {role}-server.key
        openssl req -new -key {role}-server.key -subj "/O=system:nodes/CN=system:node:{role}" -out {role}-server.csr
        cat > {role}-server.ext << 'CNF'
        basicConstraints=critical,CA:FALSE
        keyUsage=critical,digitalSignature
        extendedKeyUsage=serverAuth
        subjectAltName=DNS:{role},IP:{ip}
        CNF
        openssl x509 -req -in {role}-server.csr -CA {signer_dir}/tls.crt -CAkey {signer_dir}/tls.key -CAcreateserial -out {role}-server.crt -days 29 -extfile {role}-server.ext
        openssl ecparam -name prime256v1 -genkey -out {role}-client.key
        openssl req -new -key {role}-client.key -subj "/O=system:nodes/CN=system:node:{role}" -out {role}-client.csr
        cat > {role}-client.ext << 'CNF'
        basicConstraints=critical,CA:FALSE
        keyUsage=critical,digitalSignature
        extendedKeyUsage=clientAuth
        CNF
        openssl x509 -req -in {role}-client.csr -CA {signer_dir}/tls.crt -CAkey {signer_dir}/tls.key -CAcreateserial -out {role}-client.crt -days 29 -extfile {role}-client.ext
        """)


