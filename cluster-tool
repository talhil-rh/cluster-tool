def parse_oc_nodes(text):
    """Parse node readiness from oc get nodes output."""
    rows = []
    for line in text.splitlines():
        parts = line.split()
        if len(parts) < 2 or parts[0] == "NAME":
            continue
        rows.append({"name": parts[0], "ready": parts[1] == "Ready"})
    return rows


def parse_oc_co(text):
    """Parse ClusterOperator status from oc get co output."""
    operators = []
    for line in text.splitlines():
        parts = line.split()
        if len(parts) < 5 or parts[0] == "NAME":
            continue
        operators.append({
            "name": parts[0],
            "available": parts[2],
            "progressing": parts[3],
            "degraded": parts[4],
        })
    return operators


def compact_health(nodes, etcd_members, operators):
    """Decide whether three ready nodes, etcd, and operators meet the pass bar."""
    ready = sum(1 for node in nodes if node.get("ready"))
    started = sum(1 for member in etcd_members if member.get("started"))
    leader = any(member.get("leader") for member in etcd_members)
    unhealthy = [
        op["name"] for op in operators
        if op.get("available") != "True" or op.get("progressing") != "False" or op.get("degraded") != "False"
    ]
    return {
        "ok": ready == len(COMPACT_ROLES) and started == len(COMPACT_ROLES) and leader and not unhealthy,
        "ready": ready,
        "etcd_started": started,
        "leader": leader,
        "unhealthy_operators": unhealthy,
    }


def build_compact_boot_plan(source, clone_id, subnet, macs, snapshot, crypto_dir, ingress_cn, plan_path):
    """Build the libvirt plan for a compact clone."""
    nodes = compact_node_plan(clone_id, subnet, macs)
    vm_xml = {
        node["role"]: gen_compact_vm_xml(clone_id, node, [f"/var/lib/libvirt/images/{clone_id}-{node['role']}.qcow2"])
        for node in nodes
    }
    return {
        "clone_id": clone_id,
        "subnet": subnet,
        "domain": f"test-infra-cluster-{clone_id}.redhat.com",
        "nodes": nodes,
        "network_xml": gen_compact_network_xml(clone_id, subnet, nodes),
        "vm_xml": vm_xml,
        "restore": compact_etcd_restore_commands(nodes, snapshot, clone_id),
        "recert": recert_compact_commands(source, clone_id, nodes, crypto_dir, ingress_cn, plan_path),
        "heal": compact_heal_plan(
            source, clone_id, nodes, crypto_dir, ingress_cn, plan_path,
            signer_dir=f"{crypto_dir}/csr-signer"),
        "replacements": compact_identity_pairs(source, clone_id, nodes),
        "chrony_wait_stop": list(CHRONY_WAIT_STOP),
    }


def define_compact_libvirt(plan, emulator, machine_type, memory_kib, vcpus):
    """Define the compact libvirt network and three guest domains."""
    clone_id = plan["clone_id"]
    net_path = f"/tmp/net-{clone_id}.xml"
    env.write_file(net_path, plan["network_xml"])
    env.run(f"virsh net-define {shlex.quote(net_path)}")
    for node in plan["nodes"]:
        disks = node.get("disks")
        if isinstance(disks, str):
            disks = [disks]
        if not disks:
            disks = [node.get("disk") or f"/var/lib/libvirt/images/{clone_id}-{node['role']}.qcow2"]
        xml = gen_compact_vm_xml(
            clone_id, node, disks,
            memory_kib=memory_kib, vcpus=vcpus,
            machine_type=machine_type, emulator=emulator)
        path = f"/tmp/vm-{node['domain']}.xml"
        env.write_file(path, xml)
        env.run(f"virsh define {shlex.quote(path)}")


def undefine_compact_libvirt(clone_id):
    """Destroy and undefine the compact guests and their network."""
    for role in COMPACT_ROLES:
        domain = f"test-infra-cluster-{clone_id}-{role}"
        env.run(f"virsh destroy {shlex.quote(domain)}", check=False)
        env.run(f"virsh undefine {shlex.quote(domain)}", check=False)
        env.run(f"rm -f {shlex.quote(f'/var/lib/libvirt/images/{clone_id}-{role}.qcow2')}", check=False)
        env.run(f"rm -f {shlex.quote(compact_role_disk_dest(clone_id, role, 0))}", check=False)
        env.run(f"rm -f {shlex.quote(compact_role_disk_dest(clone_id, role, 1))}", check=False)
    net = f"test-infra-net-{clone_id}"
    env.run(f"virsh net-destroy {shlex.quote(net)}", check=False)
    env.run(f"virsh net-undefine {shlex.quote(net)}", check=False)


def gen_compact_network_xml(clone_id, subnet, nodes):
    """Build libvirt network XML for a compact clone."""
    domain = f"test-infra-cluster-{clone_id}.redhat.com"
    api = f"192.168.{subnet}.{COMPACT_API_SUFFIX}"
    ingress = f"192.168.{subnet}.{COMPACT_INGRESS_SUFFIX}"
    dhcp_hosts = ""
    for node in nodes:
        dhcp_hosts += (
            f"\n              <host mac='{node['mac']}' "
            f"name='{node['domain']}' ip='{node['ip']}'/>"
        )
    bridge = compact_bridge_name(clone_id)
    return textwrap.dedent(f"""\
        <network xmlns:dnsmasq="http://libvirt.org/schemas/network/dnsmasq/1.0">
          <name>test-infra-net-{clone_id}</name>
          <forward mode='nat'><nat><port start='1024' end='65535'/></nat></forward>
          <bridge name='{bridge}' stp='on' delay='0'/>
          <mtu size='1500'/>
          <domain name='{domain}' localOnly='yes'/>
          <dns enable='yes'>
            <host ip='{api}'>
              <hostname>api-int.{domain}</hostname>
              <hostname>api.{domain}</hostname>
            </host>
            <host ip='{ingress}'>
              <hostname>oauth-openshift.apps.{domain}</hostname>
              <hostname>console-openshift-console.apps.{domain}</hostname>
              <hostname>canary-openshift-ingress-canary.apps.{domain}</hostname>
            </host>
          </dns>
          <ip family='ipv4' address='192.168.{subnet}.1' prefix='24'>
            <dhcp>
              <range start='192.168.{subnet}.128' end='192.168.{subnet}.254'/>{dhcp_hosts}
            </dhcp>
          </ip>
          <dnsmasq:options>
            <dnsmasq:option value="address=/api.{domain}/{api}"/>
            <dnsmasq:option value="address=/api-int.{domain}/{api}"/>
            <dnsmasq:option value="address=/.apps.{domain}/{ingress}"/>
          </dnsmasq:options>
        </network>""")


def gen_compact_vm_xml(clone_id, node, overlay_disks,
                       memory_kib=67108864, vcpus=16,
                       machine_type=DEFAULT_VM_MACHINE_TYPE, emulator=DEFAULT_VM_EMULATOR):
    """Build libvirt domain XML for one compact guest."""
    if isinstance(overlay_disks, str):
        overlay_disks = [overlay_disks]
    disk_xml = ""
    for i, overlay in enumerate(overlay_disks):
        dev = f"vd{chr(97 + i)}"
        disk_xml += (
            f"\n            <disk type='file' device='disk'>"
            f"\n              <driver name='qemu' type='qcow2'/>"
            f"\n              <source file='{overlay}'/>"
            f"\n              <target dev='{dev}' bus='virtio'/>"
            f"\n            </disk>")
    return textwrap.dedent(f"""\
        <domain type='kvm'>
          <name>{node['domain']}</name>
          <memory unit='KiB'>{memory_kib}</memory>
          <currentMemory unit='KiB'>{memory_kib}</currentMemory>
          <vcpu placement='static'>{vcpus}</vcpu>
          <os>
            <type arch='x86_64' machine='{machine_type}'>hvm</type>
            <boot dev='hd'/>
          </os>
          <features><acpi/><apic/><pae/></features>
          <cpu mode='host-passthrough' check='none' migratable='on'/>
          <clock offset='utc'/>
          <on_poweroff>destroy</on_poweroff>
          <on_reboot>restart</on_reboot>
          <on_crash>destroy</on_crash>
          <devices>
            <emulator>{emulator}</emulator>{disk_xml}
            <controller type='scsi' index='0' model='virtio-scsi'/>
            <interface type='network'>
              <mac address='{node['mac']}'/>
              <source network='test-infra-net-{clone_id}'/>
              <model type='virtio'/>
            </interface>
            <serial type='pty'><target port='0'/></serial>
            <console type='pty'><target type='serial' port='0'/></console>
          </devices>
        </domain>""")


