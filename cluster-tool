def run_compact_clone(source, clone_id, subnet, identity, memory_kib=None, vcpus=None, resume=None):
    """Clone a live compact source onto a new subnet and heal it."""
    clone_id = _safe_clone_id(clone_id)
    source_subnet = int(source["nodes"][0]["ip"].split(".")[2])
    if subnet == source_subnet:
        sys.exit(f"Refusing to clone onto source subnet {subnet}.")
    work = f"/var/lib/libvirt/images/{clone_id}"
    exists = env.run(f"test -e {shlex.quote(work)} && echo yes || true")
    if resume in ("recert", "heal", "health"):
        if "yes" not in exists.stdout:
            sys.exit(f"Nothing to resume at {work}.")
    elif "yes" in exists.stdout:
        sys.exit(f"{work} already exists. Remove that clone before running this one.")
    else:
        record_compact_clone(clone_id, subnet, source.get("source", "compact"))
    macs = [node["mac"] for node in source["nodes"]]
    nodes = compact_node_plan(clone_id, subnet, macs)
    by_role = {node["role"]: node for node in nodes}
    for node in nodes:
        node["hostname"] = node["role"]
        node["disk"] = f"{work}/{node['role']}.qcow2"
    disks = compact_clone_disks(clone_id, source["nodes"])
    memory_kib = memory_kib or source["memory_kib"]
    vcpus = vcpus or source["vcpus"]
    crypto = f"{work}/crypto"
    plan_path = "/out/summary.txt"
    ingress_holder = f"{crypto}/ingress-cn.txt"
    if resume in ("recert", "heal", "health"):
        ingress_cn = env.run(f"cat {shlex.quote(ingress_holder)}").stdout.strip()
        src_kc = f"{work}/source.kubeconfig"
        api_ip = by_role[QUORUM_ETCD_ROLE]["ip"]
        image_r = _vm(api_ip,
            "sudo python3 -c \"import yaml; d=yaml.safe_load(open('/etc/kubernetes/manifests/etcd-pod.yaml')); "
            "print(next(c['image'] for c in d['spec']['containers'] if c['name']=='etcd'))\"",
            identity)
        etcd_image = image_r.stdout.strip()
        pairs = compact_identity_pairs(source, clone_id, nodes)
        _clone_log(work, f"resume at {resume}")
        return _finish_compact_clone(
            source, clone_id, nodes, identity, work, crypto, etcd_image, ingress_cn,
            plan_path, by_role, api_ip, src_kc, pairs,
            start_at={"heal": "rewrite", "health": "health"}.get(resume))

    env.run(
        f"mkdir -p {shlex.quote(crypto)} && chmod 755 {shlex.quote(work)} && chmod 700 {shlex.quote(crypto)}")
    _clone_log(work, f"clone {clone_id} subnet {subnet} from {source['source']} {source['network']}")

    _clone_log(work, "extract signer keys from the source API")
    src_pin = next(node["ip"] for node in source["nodes"] if node["role"] == QUORUM_ETCD_ROLE)
    src_kc = f"{work}/source.kubeconfig"
    env.run(
        "ssh " + " ".join(SSH_OPTS) + f" -i {shlex.quote(identity)} core@{src_pin} "
        "'sudo cat /etc/kubernetes/static-pod-resources/kube-apiserver-certs/secrets/node-kubeconfigs/lb-ext.kubeconfig' "
        f"> {shlex.quote(src_kc)}")
    env.run(f"chmod 600 {shlex.quote(src_kc)}")
    src_oc = _oc(src_kc, f"https://{src_pin}:6443")
    for secret, namespace, key, dest in (
        ("loadbalancer-serving-signer", "openshift-kube-apiserver-operator", "tls.key", "lb-signer.key"),
        ("localhost-serving-signer", "openshift-kube-apiserver-operator", "tls.key", "localhost-signer.key"),
        ("service-network-serving-signer", "openshift-kube-apiserver-operator", "tls.key", "service-network-signer.key"),
        ("router-ca", "openshift-ingress-operator", "tls.key", "ingress.key"),
        ("etcd-signer", "openshift-etcd", "tls.crt", "etcd-signer.crt"),
        ("etcd-signer", "openshift-etcd", "tls.key", "etcd-signer.key"),
        ("etcd-metric-signer", "openshift-etcd", "tls.crt", "etcd-metric-signer.crt"),
        ("etcd-metric-signer", "openshift-etcd", "tls.key", "etcd-metric-signer.key"),
    ):
        _extract_secret(src_oc, namespace, secret, key, f"{crypto}/{dest}")
    cn = env.run(
        f"{src_oc} get secret/router-ca -n openshift-ingress-operator "
        "-o jsonpath='{.data.tls\\.crt}' | base64 -d | openssl x509 -noout -subject | sed 's/subject=CN *= *//'")
    if not cn.stdout.strip():
        sys.exit("Failed to read the ingress signer CN")
    env.run(f"printf '%s\\n' {shlex.quote(cn.stdout.strip())} > {shlex.quote(ingress_holder)}")
    ingress_cn = cn.stdout.strip()

    _clone_log(work, "save one etcd snapshot from the source quorum")
    image_r = _vm(src_pin,
        "sudo python3 -c \"import yaml; d=yaml.safe_load(open('/etc/kubernetes/manifests/etcd-pod.yaml')); "
        "print(next(c['image'] for c in d['spec']['containers'] if c['name']=='etcd'))\"",
        identity)
    etcd_image = image_r.stdout.strip()
    if not etcd_image:
        sys.exit("Could not read the etcd image from the source")
    _vm(src_pin, "sudo rm -rf /var/tmp/ct-snapshot && sudo mkdir -p /var/tmp/ct-snapshot && sudo chmod 755 /var/tmp/ct-snapshot", identity)
    _vm(src_pin, " ".join([
        "sudo podman run --rm --network host --privileged",
        "--authfile /var/lib/kubelet/config.json",
        "-v /etc/kubernetes/static-pod-resources/etcd-certs:/certs:ro",
        "-v /var/tmp/ct-snapshot:/out",
        "--entrypoint etcdctl", shlex.quote(etcd_image),
        "--endpoints=https://127.0.0.1:2379",
        "--cacert /certs/configmaps/etcd-all-bundles/server-ca-bundle.crt",
        "--cert /certs/secrets/etcd-all-certs/etcd-peer-master-0-1.crt",
        "--key /certs/secrets/etcd-all-certs/etcd-peer-master-0-1.key",
        "snapshot save /out/snapshot.db",
    ]), identity)
    _vm(src_pin, "sudo chmod 644 /var/tmp/ct-snapshot/snapshot.db", identity)
    env.run(
        "scp " + " ".join(SSH_OPTS) + f" -i {shlex.quote(identity)} "
        f"core@{src_pin}:/var/tmp/ct-snapshot/snapshot.db {shlex.quote(work + '/snapshot.db')}")
    _vm(src_pin, "sudo rm -rf /var/tmp/ct-snapshot", identity, check=False)

    _clone_log(work, "reflink-copy the three source disks")
    for command in compact_copy_commands(disks):
        env.run(command)

    _start_compact_clone(
        source, clone_id, subnet, nodes, macs, identity, work, crypto,
        etcd_image, ingress_cn, memory_kib, vcpus)



