def _ingress_domain_schema(doc):
    """Yield the Ingress spec.domain OpenAPI nodes from a CRD document."""
    for version in doc.get("spec", {}).get("versions") or []:
        domain = (
            ((version.get("schema") or {}).get("openAPIV3Schema") or {})
            .get("properties", {})
            .get("spec", {})
            .get("properties", {})
            .get("domain")
        )
        if isinstance(domain, dict):
            yield domain


def compact_strip_ingress_domain_lock(raw):
    """Remove the CEL rule that makes ingress spec.domain immutable."""
    doc = json.loads(raw)
    for domain in _ingress_domain_schema(doc):
        domain.pop("x-kubernetes-validations", None)
    return json.dumps(doc)


def compact_apply_clone_ingress_domain(oc, clone_id, work):
    """Set ingress spec.domain to the clone apps domain.

    OpenShift rejects oc patch because spec.domain is immutable on the CRD.
    Lift that CEL rule, patch the object, then put the original CRD back.
    """
    wanted = compact_apps_domain(clone_id)
    if compact_identity_domains(oc).get("apps_domain") == wanted:
        return True
    crd = env.run(
        f"{oc} get crd ingresses.config.openshift.io -o json",
        check=False)
    if crd.returncode != 0 or not (crd.stdout or "").strip():
        return False
    unlocked = f"{work}/ingresses.config.crd.unlocked.json"
    original = f"{work}/ingresses.config.crd.original.json"
    env.write_file(original, crd.stdout)
    env.write_file(unlocked, compact_strip_ingress_domain_lock(crd.stdout))
    body = compact_identity_domain_patches(clone_id)["ingress"]
    ok = False
    for _ in range(5):
        env.run(f"{oc} replace -f {shlex.quote(unlocked)}", check=False)
        patched = env.run(
            f"{oc} patch ingresses.config.openshift.io cluster --type=merge "
            f"-p {shlex.quote(json.dumps(body))}",
            check=False)
        if patched.returncode == 0:
            ok = True
            break
        time.sleep(2)
    env.run(f"{oc} replace -f {shlex.quote(original)}", check=False)
    return ok or compact_identity_domains(oc).get("apps_domain") == wanted


def _router_cert_subject(oc):
    """Read the default router certificate subject."""
    raw = env.run(
        f"{oc} get secret router-certs-default -n openshift-ingress "
        "-o jsonpath='{.data.tls\\.crt}'",
        check=False)
    if raw.returncode != 0 or not (raw.stdout or "").strip():
        return ""
    subject = env.run(
        "printf '%s' " + shlex.quote((raw.stdout or "").strip()) + " | base64 -d | openssl x509 -noout -subject",
        check=False)
    return (subject.stdout or "").strip()


def _sync_ingress_wildcard(oc, clone_id, work):
    """Point the default router at the clone apps domain and reissue its wildcard.

    IngressController status.domain stays on the source name after spec.domain
    changes, and the router keeps serving that source wildcard.
    """
    host = compact_ingress_wildcard_host(clone_id)
    patch = compact_ingresscontroller_status_patch(clone_id)
    env.run(
        f"{oc} patch ingresscontroller default -n openshift-ingress-operator "
        f"--subresource=status --type=merge -p {shlex.quote(json.dumps(patch))}",
        check=False)
    subject = _router_cert_subject(oc)
    if host in subject:
        return True
    out = f"{work}/router-wildcard"
    env.run(f"mkdir -p {shlex.quote(out)} && chmod 700 {shlex.quote(out)}")
    extracted = env.run(
        f"{oc} extract secret/router-ca -n openshift-ingress-operator "
        f"--to={shlex.quote(out)} --confirm",
        check=False)
    if extracted.returncode != 0:
        _clone_log(work, "router CA is not available yet")
        return False
    env.write_file(f"{out}/san.cnf", textwrap.dedent(f"""\
        basicConstraints=CA:FALSE
        keyUsage=digitalSignature,keyEncipherment
        extendedKeyUsage=serverAuth
        subjectAltName=DNS:{host}
        """))
    signed = env.run(textwrap.dedent(f"""\
        set -euo pipefail
        cd {shlex.quote(out)}
        openssl req -new -newkey rsa:2048 -nodes -keyout leaf.key \\
            -subj {shlex.quote('/CN=' + host)} -out leaf.csr >/dev/null 2>&1
        openssl x509 -req -in leaf.csr -CA tls.crt -CAkey tls.key -CAcreateserial \\
            -out leaf.crt -days 720 -extfile san.cnf >/dev/null 2>&1
        cat leaf.crt tls.crt > full.crt
        openssl verify -CAfile tls.crt leaf.crt >/dev/null
        python3 - << 'PY'
        import base64, json, os, pathlib
        patch = {{"data": {{
            "tls.crt": base64.b64encode(pathlib.Path("full.crt").read_bytes()).decode(),
            "tls.key": base64.b64encode(pathlib.Path("leaf.key").read_bytes()).decode(),
        }}}}
        pathlib.Path("patch.json").write_text(json.dumps(patch))
        os.chmod("patch.json", 0o600)
        PY
        """), check=False)
    if signed.returncode != 0:
        _clone_log(work, "could not sign the clone ingress wildcard")
        env.run(f"rm -rf {shlex.quote(out)}", check=False)
        return False
    patched = env.run(
        f"{oc} patch secret router-certs-default -n openshift-ingress --type=merge "
        f"--patch-file {shlex.quote(out + '/patch.json')}",
        check=False)
    env.run(f"rm -rf {shlex.quote(out)}", check=False)
    if patched.returncode != 0:
        _clone_log(work, "could not install the clone ingress wildcard")
        return False
    _clone_log(work, "installed the clone ingress wildcard")
    return host in _router_cert_subject(oc) or patched.returncode == 0


def format_compact_heal(heal):
    """Describe the heal by role and step count, without addresses or Recert arguments."""
    recert = heal["recert_once"]
    copy = heal["etcd_cert_copy"]
    lines = [
        "Compact heal. Recert runs once. A second Recert run is not part of this plan.",
        f"1. Recert on {recert['name']} only. Continue when stderr contains: {recert['expected_error']}",
        (
            f"2. Copy quorum etcd certificates from {copy['from_role']} to {copy['to_role']}. "
            "Do not copy the Recert etcd CA the other way."
        ),
    ]
    lines.append(f"   {len(copy['paths'])} certificate paths")
    trust = heal["client_trust_copy"]
    lines.append(
        f"3. Copy the quorum client CA, aggregator client certificate, and service-account "
        f"signing keys from {trust['from_role']} to {trust['to_role']}, then start kubelet on "
        f"{trust['to_role']} (Recert stopped it). Do not copy Recert's keys the other way."
    )
    lines.append("4. Sign kubelet client and server certificates with the live CSR signer:")
    for item in heal["kubelet_sign"]:
        lines.append(f"   {item['role']}")
    lines.append(f"5. Rewrite {len(heal['rewrite_files'])} files on every master.")
    lines.append(
        f"6. Rewrite {len(heal['api_objects'])} API objects, plus infrastructure cluster "
        "spec and status, install-config, and the apiserver config."
    )
    lines.append(
        "7. Set DNS spec.baseDomain and ingress spec.domain to the clone "
        f"({heal['base_domain']}, {heal['ingress_domain']})."
    )
    lines.append("8. If chrony-wait blocks kubelet after a reboot: " + shlex.join(heal["chrony_wait_stop"]))
    lines.append(
        "9. Pass when three nodes are Ready, etcd has a leader, every ClusterOperator is green, "
        "every API server accepts the admin certificate and a service-account token, "
        "and ingress spec.domain is the clone apps domain."
    )
    return "\n".join(lines)


def cmd_compact_heal(args):
    """Print a compact heal plan, or refuse to apply it on the source subnet."""
    source = discover_compact_source(args.source, network=args.network)
    source_subnet = int(source["nodes"][0]["ip"].split(".")[2])
    if args.apply and args.subnet == source_subnet:
        sys.exit(
            f"Refusing to heal subnet {source_subnet}. That is the source cluster. "
            "Apply the heal only on a clone subnet after etcd restore."
        )
    macs = [generate_mac() for _ in COMPACT_ROLES]
    nodes = compact_node_plan(args.clone_id, args.subnet, macs)
    heal = compact_heal_plan(
        source, args.clone_id, nodes,
        crypto_dir=f"/tmp/cluster-tool-{args.clone_id}/crypto",
        ingress_cn=args.ingress_cn,
        plan_path=f"/tmp/cluster-tool-{args.clone_id}/recert-plan",
        signer_dir=f"/tmp/cluster-tool-{args.clone_id}/csr-signer",
    )
    print(format_compact_heal(heal))
    if not args.apply:
        print("\nDry run. No Recert, no certificates, and no files were changed.")
        return
    sys.exit("Run 'cluster-tool compact-clone' to create the VMs and apply this heal.")


def _safe_clone_id(clone_id):
    """Accept a lowercase DNS label of at most 31 characters."""
    if not re.fullmatch(r"[a-z0-9](?:[a-z0-9-]{0,29}[a-z0-9])?", clone_id or ""):
        sys.exit("clone id must be lowercase letters, numbers, and inner dashes")
    return clone_id


def compact_reserved_subnets(state):
    """Return subnets already claimed by a flavor or a clone."""
    reserved = set()
    for flavor in state.get("flavors", {}).values():
        for key in ("source_primary_subnet", "source_secondary_subnet"):
            if flavor.get(key) is not None:
                reserved.add(flavor[key])
    for clone in state.get("clones", {}).values():
        for key in ("subnet_primary", "subnet_secondary"):
            if clone.get(key) is not None:
                reserved.add(clone[key])
    return reserved


def require_compact_subnet(state, subnet):
    """Reject a subnet outside 1-254 or already reserved."""
    if isinstance(subnet, bool) or not isinstance(subnet, int) or not 1 <= subnet <= 254:
        sys.exit("subnet must be an integer from 1 to 254")
    if subnet in compact_reserved_subnets(state):
        sys.exit(f"subnet {subnet} is already reserved by a flavor or clone")
    return subnet


def record_compact_clone(clone_id, subnet, flavor):
    """Reserve a compact clone in state before its disks are copied."""
    with locked_state() as state:
        if clone_id in state["clones"]:
            sys.exit(f"Clone '{clone_id}' already exists.")
        require_compact_subnet(state, subnet)
        state["clones"][clone_id] = {
            "flavor": flavor,
            "topology": "compact",
            "subnet_primary": subnet,
            "subnet_secondary": subnet,
            "status": "booting",
            "created_at": datetime.now(timezone.utc).isoformat(),
        }


def compact_bridge_name(clone_id):
    """Return a unique bridge name that stays within the 15-character limit."""
    return "br-" + hashlib.sha256(clone_id.encode()).hexdigest()[:8]


def compact_role_disk_dest(clone_id, role, index):
    """Return the clone path for one disk of a compact master."""
    if index == 0:
        suffix = ""
    elif index == 1:
        suffix = "-spare"
    else:
        suffix = f"-disk{index}"
    return f"/var/lib/libvirt/images/{clone_id}/{role}{suffix}.qcow2"


def compact_flavor_node_disks(disk_names):
    """Pair flavor disk files with the three masters.

    A three-disk flavor is one OS disk per master, in list order.
    A six-disk flavor pairs disk-N.qcow2 with disk-N-spare.qcow2.
    Returns (role, os name, spare name or None).
    """
    names = list(disk_names or [])
    if len(names) == len(COMPACT_ROLES):
        return [(role, name, None) for role, name in zip(COMPACT_ROLES, names)]
    wanted = []
    for index, role in enumerate(COMPACT_ROLES):
        wanted.append((role, f"disk-{index}.qcow2", f"disk-{index}-spare.qcow2"))
    expected = [name for _, os_name, spare_name in wanted for name in (os_name, spare_name)]
    if sorted(names) != sorted(expected):
        sys.exit(
            "A compact flavor needs 3 disks, or these 6: " + ", ".join(expected))
    return wanted


def compact_clone_disks(clone_id, source_nodes):
    """Pair each source disk with its compact clone destination."""
    _safe_clone_id(clone_id)
    by_role = {_compact_node_name(node): node for node in source_nodes}
    disks = []
    for role in COMPACT_ROLES:
        sources = by_role[role]["disks"]
        if not sources:
            sys.exit(f"Source node {role} has no disks")
        for index, src in enumerate(sources):
            path = src["path"] if isinstance(src, dict) else src
            disks.append({
                "role": role,
                "source": path,
                "dest": compact_role_disk_dest(clone_id, role, index),
            })
    return disks


def compact_copy_commands(disks):
    """Build the commands that copy compact disks into the work directory."""
    dest_dir = os.path.dirname(disks[0]["dest"])
    commands = [f"mkdir -p {shlex.quote(dest_dir)}"]
    for disk in disks:
        dest = shlex.quote(disk["dest"])
        commands.append(f"cp --reflink=always {shlex.quote(disk['source'])} {dest}")
        commands.append(f"chown qemu:qemu {dest}")
        commands.append(f"restorecon {dest} || true")
    return commands


def compact_dns_bases_from_text(text):
    """Extract cluster DNS base domains from guest text."""
    bases = set(re.findall(r"test-infra-cluster-[A-Za-z0-9-]+\.redhat\.com", text or ""))
    host = re.search(r"KUBERNETES_SERVICE_HOST=['\"]?([^'\"\s]+)", text or "")
    if host:
        name = host.group(1)
        for prefix in ("api-int.", "api."):
            if name.startswith(prefix):
                bases.add(name[len(prefix):])
    return sorted(bases, key=len, reverse=True)


def parse_nm_mac(text):
    """Read a MAC address from NetworkManager keyfile text."""
    match = re.search(r"(?im)^mac-address=([0-9a-f:]{17})\s*$", text or "")
    if not match:
        return ""
    return match.group(1).lower()


def extract_k8s_secret_pems(data, secret_name):
    """Extract PEM blocks for one secret from an etcd database dump."""
    marker = f"/kubernetes.io/secrets/openshift-etcd/{secret_name}".encode()
    start = data.find(marker)
    if start < 0:
        return []
    nxt = data.find(b"/kubernetes.io/secrets/", start + len(marker))
    window = data[start:nxt if nxt > 0 else start + 20000]
    return re.findall(
        rb"-----BEGIN [A-Z0-9 ]+-----.*?-----END [A-Z0-9 ]+-----",
        window, flags=re.S)


def compact_etcd_member_ips(manifest):
    """Read the three etcd member addresses from a static pod manifest."""
    found = {}
    for name, ip in re.findall(
            r'"name"\s*:\s*"NODE_(master_0_[012])_IP"\s*,\s*"value"\s*:\s*"(\d+\.\d+\.\d+\.\d+)"',
            manifest or ""):
        found[name.replace("_", "-")] = ip
    if set(found) != set(COMPACT_ROLES):
        sys.exit("Could not read the three etcd member IPs from the flavor disk")
    return found


def compact_source_from_layout(flavor, macs, dns_bases, disk_paths, node_ips=None):
    """Build a compact source record from flavor metadata and disk paths."""
    if len(macs) != len(COMPACT_ROLES) or len(disk_paths) != len(COMPACT_ROLES):
        sys.exit("A compact flavor needs three masters and three MAC addresses")
    subnet = int(flavor["source_primary_subnet"])
    api = f"192.168.{subnet}.{COMPACT_API_SUFFIX}"
    ingress = f"192.168.{subnet}.{COMPACT_INGRESS_SUFFIX}"
    nodes = []
    for role, suffix, mac, paths in zip(COMPACT_ROLES, COMPACT_NODE_SUFFIXES, macs, disk_paths):
        if isinstance(paths, str):
            paths = [paths]
        else:
            paths = list(paths)
        if not paths:
            sys.exit(f"Source node {role} has no disks")
        ip = (node_ips or {}).get(role) or f"192.168.{subnet}.{suffix}"
        nodes.append({
            "role": role,
            "hostname": role,
            "mac": mac.lower(),
            "ip": ip,
            "disks": [{"path": path} for path in paths],
        })
    dns = []
    for base in dns_bases:
        dns.append({"name": f"api-int.{base}", "ip": api})
        dns.append({"name": f"api.{base}", "ip": api})
        dns.append({"name": f"apps.{base}", "ip": ingress})
    return {
        "topology": "compact",
        "source": flavor.get("source_cluster") or "flavor",
        "network": "flavor",
        "gateway": f"192.168.{subnet}.1",
        "machine_network": f"192.168.{subnet}.0/24",
        "api_vip": api,
        "ingress_vip": ingress,
        "memory_kib": flavor["memory_kib"],
        "vcpus": flavor["vcpus"],
        "etcd_image": flavor["etcd_image"],
        "nodes": nodes,
        "dns": dns,
    }


def compact_etcd_reissue_script(nodes, signer_dir, out_dir):
    """Build the script that reissues etcd certificates for clone addresses."""
    lines = [
        "set -euo pipefail",
        f"mkdir -p {shlex.quote(out_dir)}",
        "san_for() {",
        "  ip=\"$1\"",
        "  cat << EOF",
        "basicConstraints=critical,CA:FALSE",
        "keyUsage=critical,digitalSignature,keyEncipherment",
        "extendedKeyUsage=clientAuth,serverAuth",
        "subjectAltName=DNS:etcd.kube-system.svc,DNS:etcd.kube-system.svc.cluster.local,DNS:etcd.openshift-etcd.svc,DNS:etcd.openshift-etcd.svc.cluster.local,DNS:localhost,DNS:127.0.0.1,DNS:${ip},IP:127.0.0.1,IP:${ip}",
        "authorityKeyIdentifier=keyid",
        "EOF",
        "}",
    ]
    for node in nodes:
        role = node["role"]
        ip = node["ip"]
        for kind, signer in (
            ("peer", "etcd-signer"),
            ("serving", "etcd-signer"),
            ("serving-metrics", "etcd-metric-signer"),
        ):
            stem = f"{out_dir}/etcd-{kind}-{role}"
            lines.append(f"openssl genrsa -out {shlex.quote(stem + '.key')} 2048")
            lines.append(
                f"openssl req -new -key {shlex.quote(stem + '.key')} -subj /CN=127.0.0.1 "
                f"-out {shlex.quote(stem + '.csr')}")
            lines.append(f"san_for {shlex.quote(ip)} > {shlex.quote(stem + '.ext')}")
            lines.append(
                f"openssl x509 -req -in {shlex.quote(stem + '.csr')} "
                f"-CA {shlex.quote(signer_dir + '/' + signer + '.crt')} "
                f"-CAkey {shlex.quote(signer_dir + '/' + signer + '.key')} -CAcreateserial "
                f"-out {shlex.quote(stem + '.crt')} -days 720 -extfile {shlex.quote(stem + '.ext')}")
    return "\n".join(lines) + "\n"


def compact_proxy_command(etcd_image, peer_ips):
    """Build the etcd grpc-proxy command used during the single Recert run."""
    endpoints = ",".join(f"https://{ip}:2379" for ip in peer_ips)
    return " ".join([
        "sudo podman run -d --name etcd-proxy --network host --privileged",
        "--authfile /var/lib/kubelet/config.json",
        "-v /etc/kubernetes/static-pod-resources/etcd-certs:/certs:ro",
        "--entrypoint etcd", shlex.quote(etcd_image),
        "grpc-proxy start",
        "--listen-addr 127.0.0.1:2379",
        "--advertise-client-url 127.0.0.1:2379",
        "--data-dir /tmp/etcd-proxy",
        "--endpoints", endpoints,
        "--cacert /certs/configmaps/etcd-all-bundles/server-ca-bundle.crt",
        "--cert /certs/secrets/etcd-all-certs/etcd-peer-master-0-0.crt",
        "--key /certs/secrets/etcd-all-certs/etcd-peer-master-0-0.key",
    ])


def compact_recert_podman_command(argv):
    """Build the podman command that runs Recert once on master-0-0."""
    quoted = " ".join(shlex.quote(arg) for arg in argv)
    return " ".join([
        "sudo podman run --rm --name recert --pull=missing --network host --privileged",
        "--authfile /var/lib/kubelet/config.json",
        "-v /etc/kubernetes:/etc/kubernetes",
        "-v /var/lib/kubelet:/var/lib/kubelet",
        "-v /etc/machine-config-daemon:/etc/machine-config-daemon",
        "-v /etc/cni:/etc/cni",
        "-v /var/tmp/recert-crypto:/tmp/crypto:ro",
        "-v /var/tmp/recert-out:/out",
        shlex.quote(RECERT_IMAGE),
        quoted,
    ])


def rewrite_machineconfig(raw, pairs):
    """Rewrite a MachineConfig with compact identity replacements."""
    doc = json.loads(raw)
    config = doc.get("spec", {}).get("config", {})
    files = config.get("storage", {}).get("files", [])
    for item in files:
        source = item.get("contents", {}).get("source", "")
        if "," not in source or not source.startswith("data:"):
            continue
        header, encoded = source.split(",", 1)
        try:
            body = base64.b64decode(encoded).decode()
        except (UnicodeDecodeError, ValueError):
            continue
        item["contents"]["source"] = header + "," + base64.b64encode(
            apply_identity_preserving_pems(body, pairs).encode()).decode()
    for unit in config.get("systemd", {}).get("units", []):
        if unit.get("contents"):
            unit["contents"] = apply_identity_preserving_pems(unit["contents"], pairs)
        for dropin in unit.get("dropins") or []:
            if dropin.get("contents"):
                dropin["contents"] = apply_identity_preserving_pems(dropin["contents"], pairs)
    return json.dumps(doc)


def rewrite_configmap(raw, pairs):
    """Rewrite a ConfigMap with compact identity replacements."""
    doc = json.loads(raw)
    data = doc.get("data") or {}
    for key, value in list(data.items()):
        if isinstance(value, str):
            data[key] = apply_identity_preserving_pems(value, pairs)
    doc["data"] = data
    return json.dumps(doc)


def rewrite_deployment(raw, pairs):
    """Rewrite a Deployment with compact identity replacements and drop its status."""
    doc = json.loads(apply_identity_preserving_pems(raw, pairs))
    doc.pop("status", None)
    return json.dumps(doc)


def compact_infrastructure_patches(clone_id, subnet):
    """Build the infrastructure patches for the clone API and ingress."""
    domain = f"test-infra-cluster-{clone_id}.redhat.com"
    api = f"192.168.{subnet}.{COMPACT_API_SUFFIX}"
    ingress = f"192.168.{subnet}.{COMPACT_INGRESS_SUFFIX}"
    network = f"192.168.{subnet}.0/24"
    baremetal = {
        "apiServerInternalIPs": [api],
        "ingressIPs": [ingress],
        "machineNetworks": [network],
    }
    spec = {"spec": {"platformSpec": {"baremetal": baremetal}}}
    status = {
        "status": {
            "apiServerURL": f"https://api.{domain}:6443",
            "apiServerInternalURI": f"https://api-int.{domain}:6443",
            "platformStatus": {
                "baremetal": {
                    "apiServerInternalIP": api,
                    "apiServerInternalIPs": [api],
                    "ingressIP": ingress,
                    "ingressIPs": [ingress],
                    "machineNetworks": [network],
                }
            },
        }
    }
    return spec, status


def compact_identity_configmaps(oc):
    """List identity ConfigMaps that still need compact address rewrites."""
    found = [list(item) for item in HEAL_IDENTITY_CONFIGMAPS]
    for namespace, prefix in HEAL_CONFIGMAP_PREFIXES:
        raw = env.run(f"{oc} get cm -n {shlex.quote(namespace)} -o name", check=False)
        for line in (raw.stdout or "").splitlines():
            name = line.strip().split("/")[-1]
            if name.startswith(prefix):
                found.append([namespace, name])
    return found


def compact_release_keepalived_script():
    """Build the script that releases a stale keepalived address."""
    return textwrap.dedent("""\
        set +e
        sudo rm -f /run/nodeip-configuration/remote-worker
        sudo systemctl stop chrony-wait.service || true
        sudo systemctl mask chrony-wait.service || true
        sudo systemctl daemon-reload
        sudo timeout 90 systemctl restart nodeip-configuration.service
        exit 0
        """)


def compact_reload_apiserver_script():
    """Build the script that reloads the API server after a certificate change."""
    return textwrap.dedent("""\
        set +e
        sudo crictl pods --name kube-apiserver -q | xargs -r sudo crictl stopp
        exit 0
        """)


def compact_start_recert_node_script():
    """Start kubelet on the Recert node after Recert stopped it."""
    return textwrap.dedent("""\
        set +e
        sudo systemctl start crio
        sudo systemctl start kubelet
        exit 0
        """)


def compact_restart_cert_controller_command():
    # The cert controller reads the internal API name once, when its process
    # starts. A later crio restart does not replace that process, so it keeps
    # reissuing the source certificate and kubelet can never trust the clone API.
    """Build the command that restarts the API certificate controller."""
    return (
        "sudo crictl ps --name kube-apiserver-cert-regeneration-controller -q "
        "| xargs -r sudo crictl stop"
    )


def presented_san_matches(san_text, hostname):
    """Return whether a presented certificate SAN contains the expected hostname."""
    return bool(hostname) and hostname in (san_text or "")


def _secret_hostnames(oc, name):
    """Read hostnames recorded on a serving-certificate secret."""
    raw = env.run(
        f"{oc} get secret {shlex.quote(name)} -n openshift-kube-apiserver "
        "-o jsonpath='{.metadata.annotations.auth\\.openshift\\.io/certificate-hostnames}'",
        check=False)
    return (raw.stdout or "").strip()


def _presented_san(ip, servername):
    """Read the subject alternative names presented by the API server."""
    raw = env.run(
        "echo | openssl s_client -connect "
        f"{shlex.quote(ip + ':6443')} -servername {shlex.quote(servername)} 2>/dev/null "
        "| openssl x509 -noout -ext subjectAltName",
        check=False)
    return raw.stdout or ""


def _push_lb_cert(identity, nodes, work, secret):
    """Copy a load-balancer certificate onto each compact node."""
    src = f"{work}/lb-{secret}"
    for node in nodes:
        env.run(
            "scp " + " ".join(SSH_OPTS) + f" -i {shlex.quote(identity)} "
            f"{shlex.quote(src + '/tls.crt')} core@{node['ip']}:/var/tmp/{secret}.crt")
        env.run(
            "scp " + " ".join(SSH_OPTS) + f" -i {shlex.quote(identity)} "
            f"{shlex.quote(src + '/tls.key')} core@{node['ip']}:/var/tmp/{secret}.key")
        dest = f"/etc/kubernetes/static-pod-resources/kube-apiserver-certs/secrets/{secret}"
        _vm(node["ip"], textwrap.dedent(f"""\
            set -euo pipefail
            sudo install -o root -g root -m 600 /var/tmp/{secret}.crt {dest}/tls.crt
            sudo install -o root -g root -m 600 /var/tmp/{secret}.key {dest}/tls.key
            rm -f /var/tmp/{secret}.crt /var/tmp/{secret}.key
            """), identity)


def _install_lb_serving_cert(oc, work, secret, hostname, api_ip, signer):
    """Install a signed load-balancer serving certificate into the cluster."""
    out = f"{work}/lb-{secret}"
    env.write_file(f"{work}/sign-{secret}.sh", compact_lb_cert_script(hostname, api_ip, signer, out))
    env.run(f"bash {shlex.quote(work + '/sign-' + secret + '.sh')}")
    script = textwrap.dedent(f"""\
        set -euo pipefail
        cd {out}
        python3 - << 'PY'
        import base64, json, os, pathlib
        patch = {{
            "data": {{
                "tls.crt": base64.b64encode(pathlib.Path("tls.crt").read_bytes()).decode(),
                "tls.key": base64.b64encode(pathlib.Path("tls.key").read_bytes()).decode(),
            }},
            "metadata": {{"annotations": {{"auth.openshift.io/certificate-hostnames": {hostname!r}}}}},
        }}
        pathlib.Path("patch.json").write_text(json.dumps(patch))
        os.chmod("patch.json", 0o600)
        PY
        {oc} patch secret {shlex.quote(secret)} -n openshift-kube-apiserver --type=merge --patch-file {shlex.quote(out + '/patch.json')}
        rm -f patch.json
        """)
    env.write_file(f"{work}/install-{secret}.sh", script)
    env.run(f"bash {shlex.quote(work + '/install-' + secret + '.sh')}")


def _ensure_api_certificates(oc, work, domain, api_ip, nodes, identity):
    """Sign and install the clone API serving certificates."""
    wanted = {
        "internal-loadbalancer-serving-certkey": f"api-int.{domain}",
        "external-loadbalancer-serving-certkey": f"api.{domain}",
    }
    for _ in range(6):
        if all(wanted[name] in _secret_hostnames(oc, name) for name in wanted):
            break
        time.sleep(10)
    if not all(wanted[name] in _secret_hostnames(oc, name) for name in wanted):
        _clone_log(work, "signing API serving certificates with the load balancer signer")
        signer = f"{work}/lb-signer"
        env.run(f"mkdir -p {shlex.quote(signer)} && chmod 700 {shlex.quote(signer)}")
        _extract_secret(oc, "openshift-kube-apiserver-operator", "loadbalancer-serving-signer", "tls.crt", f"{signer}/tls.crt")
        _extract_secret(oc, "openshift-kube-apiserver-operator", "loadbalancer-serving-signer", "tls.key", f"{signer}/tls.key")
        for secret, hostname in wanted.items():
            _install_lb_serving_cert(oc, work, secret, hostname, api_ip, signer)
            _push_lb_cert(identity, nodes, work, secret)
    for _ in range(6):
        if presented_san_matches(
            _presented_san(api_ip, wanted["internal-loadbalancer-serving-certkey"]),
            wanted["internal-loadbalancer-serving-certkey"],
        ):
            return
        for node in nodes:
            _vm(node["ip"], compact_reload_apiserver_script(), identity, check=False)
        time.sleep(15)
    _clone_log(work, "API certificate does not yet present the clone name")


def _refresh_internal_api_certificate(oc, work, domain, api_ip, nodes, identity):
    """Restart the cert controller and wait until the API presents the clone name."""
    hostname = f"api-int.{domain}"
    _clone_log(work, "restart the API cert controller so it re-reads the clone API name")
    for node in nodes:
        _vm(node["ip"], compact_restart_cert_controller_command(), identity, check=False)
    matched = False
    # Leader election can take the full lease before the new process reads infrastructure.
    for _ in range(48):
        if hostname in _secret_hostnames(oc, "internal-loadbalancer-serving-certkey"):
            matched = True
            break
        time.sleep(5)
    if not matched:
        sys.exit(
            f"The API cert controller did not issue a certificate for {hostname}. "
            f"Kubelet cannot trust the API, so the network rollout cannot finish. "
            f"Log: {work}/clone.log")
    for _ in range(8):
        if presented_san_matches(_presented_san(api_ip, hostname), hostname):
            _clone_log(work, "API certificate presents the clone name")
            return
        for node in nodes:
            _vm(node["ip"], compact_reload_apiserver_script(), identity, check=False)
        time.sleep(10)
    sys.exit(
        f"The apiserver is not presenting a certificate for {hostname}. "
        f"Kubelet cannot trust the API, so the network rollout cannot finish. "
        f"Log: {work}/clone.log")


def compact_lb_cert_script(hostname, ip, signer_dir, out_dir):
    """Build the script that signs one load-balancer serving certificate."""
    return textwrap.dedent(f"""\
        set -euo pipefail
        mkdir -p {out_dir}
        chmod 700 {out_dir}
        cat > {out_dir}/ext.cnf << 'EOF'
        basicConstraints=critical,CA:FALSE
        keyUsage=critical,digitalSignature,keyEncipherment
        extendedKeyUsage=serverAuth
        subjectAltName=DNS:{hostname},IP:{ip}
        authorityKeyIdentifier=keyid
        EOF
        openssl req -new -newkey rsa:2048 -nodes -keyout {out_dir}/tls.key \\
          -subj "/CN={hostname}" -out {out_dir}/tls.csr
        openssl x509 -req -in {out_dir}/tls.csr -CA {signer_dir}/tls.crt -CAkey {signer_dir}/tls.key \\
          -CAcreateserial -out {out_dir}/tls.crt -days 720 -extfile {out_dir}/ext.cnf
        chmod 600 {out_dir}/tls.key {out_dir}/tls.crt
        """)


def compact_stop_workloads_script():
    """Build the script that stops workloads before the compact heal."""
    return textwrap.dedent("""\
        set +e
        sudo systemctl stop kubelet
        sudo systemctl stop keepalived
        sudo crictl pods -q | xargs -r sudo crictl stopp
        sudo systemctl stop crio
        sleep 2
        sudo pkill -x etcd
        sleep 1
        exit 0
        """)


def compact_identity_script():
    """Build the guest script that rewrites on-disk compact identity."""
    return textwrap.dedent(r"""
        import json, pathlib, re, sys
        pairs = json.loads(pathlib.Path("/var/tmp/identity-pairs.json").read_text())
        pairs.sort(key=lambda pair: len(pair[0]), reverse=True)
        roots = [
            "/etc/kubernetes",
            "/etc/keepalived",
            "/etc/systemd/system",
            "/usr/local/bin",
            "/etc/NetworkManager/system-connections",
        ]
        extra = ["/var/lib/kubelet/kubeconfig"]
        skip_suffix = (".crt", ".key", ".pem", ".db", ".gz", ".so", ".ko")

        def rewrite(text):
            for old, new in pairs:
                if not old or old == new:
                    continue
                if re.fullmatch(r"[0-9.]+", old):
                    text = re.sub(re.escape(old) + r"(?!\d)", new, text)
                else:
                    text = text.replace(old, new)
            return text

        paths = list(extra)
        for root in roots:
            base = pathlib.Path(root)
            if not base.exists():
                continue
            if base.is_file():
                paths.append(str(base))
                continue
            for path in base.rglob("*"):
                if path.is_file():
                    paths.append(str(path))
        changed = 0
        for name in paths:
            path = pathlib.Path(name)
            if not path.is_file() or path.suffix in skip_suffix or path.stat().st_size > 2000000:
                continue
            try:
                original = path.read_text()
            except (UnicodeDecodeError, OSError):
                continue
            updated = rewrite(original)
            if updated != original:
                path.write_text(updated)
                changed += 1
                print(name)
        print(f"rewrote {changed} files")
        """)


def _clone_log(work, message):
    """Append one timestamped progress line to the compact clone log."""
    stamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    line = f"===== {stamp} {message} ====="
    print(line, flush=True)
    env.run(f"printf '%s\\n' {shlex.quote(line)} >> {shlex.quote(work + '/clone.log')}")


def _vm(ip, script, identity, check=True):
    """Run one command on a compact guest."""
    return env.run_vm(ip, script, check=check, identity=identity)


def _wait_ssh(ip, identity, attempts=60):
    """Wait until SSH to a compact guest accepts connections."""
    for _ in range(attempts):
        probe = _vm(ip, "echo ready", identity, check=False)
        if probe.returncode == 0 and "ready" in probe.stdout:
            return
        time.sleep(5)
    sys.exit(f"SSH to {ip} did not come up")


def _oc(kubeconfig, server):
    """Build an oc command that uses the clone kubeconfig."""
    return (
        f"KUBECONFIG={shlex.quote(kubeconfig)} oc --insecure-skip-tls-verify "
        f"--request-timeout=40s --server={shlex.quote(server)}"
    )


def _admin_auth_command(kubeconfig, ip):
    """Build an oc whoami command aimed at one API server."""
    return (
        f"KUBECONFIG={shlex.quote(kubeconfig)} oc --insecure-skip-tls-verify "
        f"--request-timeout=20s --server={shlex.quote('https://' + ip + ':6443')} whoami"
    )


def compact_admin_auth_results(kubeconfig, nodes):
    """Ask every master to accept the admin client certificate."""
    results = []
    for node in nodes:
        probe = env.run(_admin_auth_command(kubeconfig, node["ip"]), check=False)
        results.append({
            "role": node["role"],
            "ok": probe.returncode == 0 and "system:" in (probe.stdout or ""),
        })
    return results


def compact_serviceaccount_auth_results(oc, nodes, work):
    """Ask every master to accept one short-lived service-account token."""
    failed = [{"role": node["role"], "ok": False} for node in nodes]
    minted = env.run(f"{oc} create token default --namespace default --duration=10m", check=False)
    token = (minted.stdout or "").strip()
    if minted.returncode != 0 or token.count(".") != 2 or any(char.isspace() for char in token):
        return failed
    path = f"{work}/.sa-probe-token"
    env.write_file(path, token + "\n")
    env.run(f"chmod 600 {shlex.quote(path)}")
    results = []
    try:
        for node in nodes:
            url = shlex.quote(f"https://{node['ip']}:6443/readyz")
            probe = env.run(
                "code=$(curl -sk -o /dev/null -w '%{http_code}' "
                f"-H \"Authorization: Bearer $(cat {shlex.quote(path)})\" {url}); "
                "printf '%s' \"$code\"",
                check=False)
            results.append({"role": node["role"], "ok": (probe.stdout or "").strip() == "200"})
    finally:
        env.run(f"rm -f {shlex.quote(path)}", check=False)
    return results


def _wait_admin_auth(kubeconfig, node, attempts=36):
    """Wait until one API server accepts the admin client certificate."""
    last = ""
    for _ in range(attempts):
        probe = env.run(_admin_auth_command(kubeconfig, node["ip"]), check=False)
        if probe.returncode == 0 and "system:" in (probe.stdout or ""):
            return
        last = ((probe.stderr or "") + "\n" + (probe.stdout or "")).strip()
        time.sleep(5)
    sys.exit(
        f"{node['role']} still rejects the cluster client certificate. "
        "The API address would keep returning credentials errors. "
        f"Last whoami: {last[:400]}")


def compact_stash_historical_certs_script():
    """Build the script that moves historical etcd certificates aside."""
    return textwrap.dedent("""\
        set -euo pipefail
        sudo mkdir -p /var/tmp/recert-stashed-pems
        for dir in /var/lib/kubelet/pki /etc/cni/multus/certs; do
          if [ -d "$dir" ]; then
            sudo find "$dir" -maxdepth 1 -name '*.pem' ! -name '*-current.pem' -exec mv {} /var/tmp/recert-stashed-pems/ \\;
          fi
        done
        """)


def _extract_secret(oc, namespace, name, key, dest):
    """Copy one secret key from the source cluster into the clone crypto directory."""
    env.run(
        f"{oc} extract secret/{name} -n {namespace} --keys={key} --to=- > {shlex.quote(dest)}")
    env.run(f"chmod 600 {shlex.quote(dest)}")


def _sync_requestheader_aggregator_ca(kubeconfig, api_ip, work, identity, quorum_ip):
    """Trust only the quorum aggregator CA for aggregated API calls.

    Recert leaves a second aggregator CA with the same subject in
    extension-apiserver-authentication. openshift-apiserver then rejects the
    quorum aggregator client certificate.
    """
    remote = (
        "/etc/kubernetes/static-pod-resources/kube-apiserver-certs/"
        "configmaps/aggregator-client-ca/ca-bundle.crt"
    )
    fetched = _vm(quorum_ip, f"sudo cat {remote}", identity, check=False)
    pem = fetched.stdout or ""
    if fetched.returncode != 0 or pem.count("BEGIN CERTIFICATE") != 1:
        _clone_log(work, "quorum aggregator CA was not a single certificate")
        return
    if not pem.endswith("\n"):
        pem += "\n"
    ca_path = f"{work}/aggregator-client-ca.crt"
    patch_path = f"{work}/requestheader-ca.patch.json"
    env.write_file(ca_path, pem)
    env.run(f"chmod 600 {shlex.quote(ca_path)}")
    oc = _oc(kubeconfig, f"https://{api_ip}:6443")
    _clone_log(work, "set aggregated API trust to the quorum aggregator CA")
    for _ in range(6):
        current = env.run(
            f"{oc} get cm extension-apiserver-authentication -n kube-system -o json",
            check=False)
        if current.returncode != 0 or not (current.stdout or "").strip():
            time.sleep(5)
            continue
        raw_path = f"{work}/extension-apiserver-authentication.json"
        env.write_file(raw_path, current.stdout)
        env.run(f"chmod 600 {shlex.quote(raw_path)}")
        decision = env.run(
            "python3 - " + shlex.quote(raw_path) + " " + shlex.quote(ca_path) + " " + shlex.quote(patch_path) + """ << 'PY'
import json, os, pathlib, sys
raw_path, ca_path, patch_path = sys.argv[1:]
pem = pathlib.Path(ca_path).read_text()
doc = json.loads(pathlib.Path(raw_path).read_text())
have = ((doc.get("data") or {}).get("requestheader-client-ca-file") or "")
if have.strip() == pem.strip() and have.count("BEGIN CERTIFICATE") == 1:
    print("unchanged")
    raise SystemExit(0)
pathlib.Path(patch_path).write_text(json.dumps({"data": {"requestheader-client-ca-file": pem}}))
os.chmod(patch_path, 0o600)
print("update")
PY""",
            check=False)
        env.run(f"rm -f {shlex.quote(raw_path)}", check=False)
        status = (decision.stdout or "").strip().splitlines()
        if decision.returncode == 0 and status and status[-1] == "unchanged":
            env.run(f"rm -f {shlex.quote(ca_path)} {shlex.quote(patch_path)}", check=False)
            return
        if decision.returncode == 0 and status and status[-1] == "update":
            patched = env.run(
                f"{oc} patch cm extension-apiserver-authentication -n kube-system "
                f"--type=merge --patch-file {shlex.quote(patch_path)}",
                check=False)
            env.run(f"rm -f {shlex.quote(patch_path)}", check=False)
            if patched.returncode == 0:
                env.run(f"rm -f {shlex.quote(ca_path)}", check=False)
                return
        time.sleep(5)
    env.run(f"rm -f {shlex.quote(ca_path)} {shlex.quote(patch_path)}", check=False)
    _clone_log(work, "aggregated API trust still has a second aggregator CA")


def _finish_compact_clone(source, clone_id, nodes, identity, work, crypto, etcd_image, ingress_cn, plan_path, by_role, api_ip, src_kc, pairs, start_at=None):
    """Finish certificate heal, identity rewrite, and the compact health wait."""
    if start_at == "health":
        _clone_log(work, "resume at the health check")
    elif start_at == "rewrite":
        _clone_log(work, "resume after the Recert commit; rewriting cluster records")
    else:
        _clone_log(work, "run Recert once on master-0-0")
        recert_node = by_role[RECERT_ROLE]
        _vm(recert_node["ip"], compact_stop_workloads_script(), identity)
        _vm(recert_node["ip"], compact_stash_historical_certs_script(), identity)
        peers = [by_role[role]["ip"] for role in COMPACT_ROLES if role != RECERT_ROLE]
        _vm(recert_node["ip"], "sudo podman rm -f etcd-proxy recert >/dev/null 2>&1 || true", identity, check=False)
        _vm(recert_node["ip"], "sudo mkdir -p /var/tmp/recert-crypto /var/tmp/recert-out && sudo chown core:core /var/tmp/recert-crypto /var/tmp/recert-out", identity)
        env.run(
            "scp " + " ".join(SSH_OPTS) + f" -i {shlex.quote(identity)} "
            f"{shlex.quote(crypto)}/lb-signer.key {shlex.quote(crypto)}/localhost-signer.key "
            f"{shlex.quote(crypto)}/service-network-signer.key {shlex.quote(crypto)}/ingress.key "
            f"core@{recert_node['ip']}:/var/tmp/recert-crypto/")
        _vm(recert_node["ip"], compact_proxy_command(etcd_image, peers), identity)
        heal = compact_heal_plan(source, clone_id, nodes, "/tmp/crypto", ingress_cn, plan_path, "/tmp/crypto/csr-signer")
        recert = _vm(recert_node["ip"], compact_recert_podman_command(heal["recert_once"]["argv"]), identity, check=False)
        combined = (recert.stdout or "") + (recert.stderr or "")
        summary_hit = _vm(
            recert_node["ip"],
            "sudo grep -a -q 'Expected exactly one node' /var/tmp/recert-out/summary.txt",
            identity, check=False)
        _vm(recert_node["ip"], "sudo chmod 600 /var/tmp/recert-out/summary.txt || true", identity, check=False)
        expected = heal["recert_once"]["expected_error"] in combined or summary_hit.returncode == 0
        _clone_log(work, f"recert exit {recert.returncode} expected_single_node_error={expected}")
        if recert.returncode != 0 and not expected:
            sys.exit(
                f"Recert failed (exit {recert.returncode}) without the expected single-node message. "
                f"It was not run again. Log: {work}/clone.log")
        _vm(recert_node["ip"], "sudo podman rm -f etcd-proxy >/dev/null 2>&1 || true", identity, check=False)
        _clone_log(work, "Recert finished once; copying quorum etcd certificates back to master-0-0")
        quorum = by_role[QUORUM_ETCD_ROLE]
        env.run(
            "ssh " + " ".join(SSH_OPTS) + f" -i {shlex.quote(identity)} core@{quorum['ip']} "
            "'sudo tar -C /etc/kubernetes/static-pod-resources -cf - etcd-certs' "
            f"> {shlex.quote(work + '/etcd-certs-quorum.tar')}")
        env.run(
            "ssh " + " ".join(SSH_OPTS) + f" -i {shlex.quote(identity)} core@{recert_node['ip']} "
            "'sudo tar -C /etc/kubernetes/static-pod-resources -cf - etcd-certs' "
            f"> {shlex.quote(work + '/etcd-certs-node0-recert.tar')}")
        env.run(f"chmod 600 {shlex.quote(work + '/etcd-certs-node0-recert.tar')}")
        env.run(
            "scp " + " ".join(SSH_OPTS) + f" -i {shlex.quote(identity)} "
            f"{shlex.quote(work + '/etcd-certs-quorum.tar')} core@{recert_node['ip']}:/var/tmp/etcd-certs-quorum.tar")
        _vm(recert_node["ip"],
            "sudo tar -C /etc/kubernetes/static-pod-resources -xf /var/tmp/etcd-certs-quorum.tar && "
            "sudo restorecon -R /etc/kubernetes/static-pod-resources/etcd-certs || true",
            identity)
        _clone_log(work, "restore the original etcd trust onto the Recert apiserver")
        env.run(
            "ssh " + " ".join(SSH_OPTS) + f" -i {shlex.quote(identity)} core@{quorum['ip']} "
            f"{shlex.quote(compact_apiserver_etcd_trust_tar_command())} "
            f"> {shlex.quote(work + '/apiserver-etcd-trust.tar')}")
        env.run(
            "scp " + " ".join(SSH_OPTS) + f" -i {shlex.quote(identity)} "
            f"{shlex.quote(work + '/apiserver-etcd-trust.tar')} "
            f"core@{recert_node['ip']}:/var/tmp/apiserver-etcd-trust.tar")
        _vm(recert_node["ip"],
            "sudo tar -C / -xf /var/tmp/apiserver-etcd-trust.tar && "
            "sudo restorecon -R /etc/kubernetes/static-pod-resources || true",
            identity)
        _clone_log(work, "restore quorum client CA and service-account keys onto master-0-0")
        env.run(
            "ssh " + " ".join(SSH_OPTS) + f" -i {shlex.quote(identity)} core@{quorum['ip']} "
            f"{shlex.quote(compact_apiserver_client_trust_tar_command())} "
            f"> {shlex.quote(work + '/apiserver-client-trust.tar')}")
        env.run(f"chmod 600 {shlex.quote(work + '/apiserver-client-trust.tar')}")
        env.run(
            "scp " + " ".join(SSH_OPTS) + f" -i {shlex.quote(identity)} "
            f"{shlex.quote(work + '/apiserver-client-trust.tar')} "
            f"core@{recert_node['ip']}:/var/tmp/apiserver-client-trust.tar")
        _vm(recert_node["ip"],
            "sudo tar -C / -xf /var/tmp/apiserver-client-trust.tar && "
            "sudo restorecon -R /etc/kubernetes/static-pod-resources || true",
            identity)
        quorum_digest = _vm(quorum["ip"], compact_client_trust_digest_command(), identity, check=False)
        recert_digest = _vm(recert_node["ip"], compact_client_trust_digest_command(), identity, check=False)
        if (quorum_digest.returncode != 0 or recert_digest.returncode != 0
                or quorum_digest.stdout != recert_digest.stdout):
            sys.exit(
                "master-0-0 client CA, aggregator client, or service-account keys still differ from master-0-1. "
                f"Log: {work}/clone.log")
        _clone_log(work, "start kubelet on master-0-0 so it loads the quorum client CA")
        _vm(recert_node["ip"], compact_start_recert_node_script(), identity, check=False)
        _wait_admin_auth(src_kc, recert_node)
        _sync_requestheader_aggregator_ca(src_kc, api_ip, work, identity, quorum["ip"])

        _clone_log(work, "sign kubelet certificates with the live CSR signer")
        clone_kc = f"{work}/clone.kubeconfig"
        env.run(f"cp {shlex.quote(src_kc)} {shlex.quote(clone_kc)}")
        clone_oc = _oc(clone_kc, f"https://{api_ip}:6443")
        signer = f"{work}/csr-signer"
        env.run(f"mkdir -p {shlex.quote(signer)} && chmod 700 {shlex.quote(signer)}")
        _extract_secret(clone_oc, "openshift-kube-controller-manager-operator", "csr-signer", "tls.crt", f"{signer}/tls.crt")
        _extract_secret(clone_oc, "openshift-kube-controller-manager-operator", "csr-signer", "tls.key", f"{signer}/tls.key")
        for node in nodes:
            script = kubelet_sign_script(node["role"], node["ip"], signer)
            env.write_file(f"{work}/sign-{node['role']}.sh", script)
            env.run(f"cd {shlex.quote(work)} && bash {shlex.quote('sign-' + node['role'] + '.sh')}")
            env.run(
                "scp " + " ".join(SSH_OPTS) + f" -i {shlex.quote(identity)} "
                f"{shlex.quote(work)}/{node['role']}-server.crt {shlex.quote(work)}/{node['role']}-server.key "
                f"{shlex.quote(work)}/{node['role']}-client.crt {shlex.quote(work)}/{node['role']}-client.key "
                f"core@{node['ip']}:/var/tmp/")
            _vm(node["ip"], textwrap.dedent(f"""\
                set -euo pipefail
                sudo bash -c 'cat /var/tmp/{node['role']}-server.crt /var/tmp/{node['role']}-server.key > /var/lib/kubelet/pki/kubelet-server-current.pem'
                sudo bash -c 'cat /var/tmp/{node['role']}-client.crt /var/tmp/{node['role']}-client.key > /var/lib/kubelet/pki/kubelet-client-current.pem'
                sudo chmod 600 /var/lib/kubelet/pki/kubelet-server-current.pem /var/lib/kubelet/pki/kubelet-client-current.pem
                sudo restorecon /var/lib/kubelet/pki/kubelet-server-current.pem /var/lib/kubelet/pki/kubelet-client-current.pem || true
                """), identity)
        _vm(quorum["ip"], "sudo cat /etc/kubernetes/kubelet-ca.crt", identity)
        ca_copy = env.run(
            "ssh " + " ".join(SSH_OPTS) + f" -i {shlex.quote(identity)} core@{quorum['ip']} "
            "'sudo cat /etc/kubernetes/kubelet-ca.crt'")
        env.write_file(f"{work}/kubelet-ca.crt", ca_copy.stdout)
        env.run(
            "scp " + " ".join(SSH_OPTS) + f" -i {shlex.quote(identity)} "
            f"{shlex.quote(work + '/kubelet-ca.crt')} core@{recert_node['ip']}:/var/tmp/kubelet-ca.crt")
        _vm(recert_node["ip"],
            "sudo cp /var/tmp/kubelet-ca.crt /etc/kubernetes/kubelet-ca.crt && sudo restorecon /etc/kubernetes/kubelet-ca.crt || true",
            identity)

    clone_kc = f"{work}/clone.kubeconfig"
    if "yes" not in env.run(f"test -f {shlex.quote(clone_kc)} && echo yes || true").stdout:
        env.run(f"cp {shlex.quote(src_kc)} {shlex.quote(clone_kc)}")
    clone_oc = _oc(clone_kc, f"https://{api_ip}:6443")
    if start_at != "health":
        _clone_log(work, "rewrite cluster records and 00-master")
        domain = f"test-infra-cluster-{clone_id}.redhat.com"
        for kind, namespace, name in HEAL_API_OBJECTS:
            raw = env.run(f"{clone_oc} get {kind} {name} -n {namespace} -o json", check=False)
            if raw.returncode != 0:
                _clone_log(work, f"skip missing {kind} {namespace}/{name}")
                continue
            updated = rewrite_configmap(raw.stdout, pairs) if kind == "configmap" else apply_identity(raw.stdout, pairs)
            dest = f"{work}/{kind}-{name}.json"
            env.write_file(dest, updated)
            env.run(f"{clone_oc} replace -f {shlex.quote(dest)}", check=False)
        subnet = int(nodes[0]["ip"].split(".")[2])
        api_vip = f"192.168.{subnet}.{COMPACT_API_SUFFIX}"
        spec, status = compact_infrastructure_patches(clone_id, subnet)
        env.run(
            f"{clone_oc} patch infrastructure cluster --type=merge -p {shlex.quote(json.dumps(spec))}",
            check=False)
        env.run(
            f"{clone_oc} patch infrastructure cluster --subresource=status --type=merge "
            f"-p {shlex.quote(json.dumps(status))}",
            check=False)
        for namespace, name in compact_identity_configmaps(clone_oc):
            raw = env.run(f"{clone_oc} get cm {shlex.quote(name)} -n {shlex.quote(namespace)} -o json", check=False)
            if raw.returncode != 0 or not raw.stdout.strip():
                _clone_log(work, f"skip missing configmap {namespace}/{name}")
                continue
            dest = f"{work}/cm-{namespace}-{name}.json"
            env.write_file(dest, rewrite_configmap(raw.stdout, pairs))
            env.run(f"{clone_oc} replace -f {shlex.quote(dest)}", check=False)
        _clone_log(work, "point aggregated apiservers at the clone etcd")
        for namespace, name in HEAL_ETCD_DEPLOYMENTS:
            raw = env.run(
                f"{clone_oc} get deploy {shlex.quote(name)} -n {shlex.quote(namespace)} -o json",
                check=False)
            if raw.returncode != 0 or not raw.stdout.strip():
                _clone_log(work, f"skip missing deployment {namespace}/{name}")
                continue
            dest = f"{work}/deploy-{namespace}-{name}.json"
            env.write_file(dest, rewrite_deployment(raw.stdout, pairs))
            env.run(f"{clone_oc} replace -f {shlex.quote(dest)}", check=False)
        for namespace in ("openshift-apiserver", "openshift-oauth-apiserver"):
            env.run(f"{clone_oc} delete pod -n {shlex.quote(namespace)} --all --force --grace-period=0", check=False)
        mc = env.run(f"{clone_oc} get machineconfig 00-master -o json", check=False)
        previous_render = env.run(
            f"{clone_oc} get mcp master -o jsonpath='{{.status.configuration.name}}'",
            check=False).stdout.strip()
        if mc.returncode == 0:
            env.write_file(f"{work}/00-master.json", rewrite_machineconfig(mc.stdout, pairs))
            env.run(f"{clone_oc} replace -f {shlex.quote(work + '/00-master.json')}", check=False)
        rendered = ""
        for _ in range(30):
            current_render = env.run(
                f"{clone_oc} get mcp master -o jsonpath='{{.spec.configuration.name}}'",
                check=False).stdout
            rendered = compact_new_rendered_master(previous_render, current_render)
            if rendered:
                break
            time.sleep(2)
        if rendered:
            raw_render = env.run(
                f"{clone_oc} get machineconfig {shlex.quote(rendered)} -o json", check=False)
            if raw_render.returncode == 0 and raw_render.stdout.strip():
                env.write_file(f"{work}/currentconfig.json", raw_render.stdout)
                heal_files = {
                    path: body for path, body in rendered_machineconfig_files(raw_render.stdout).items()
                    if path in HEAL_NODE_FILES
                }
                env.write_file(f"{work}/heal-files.json", json.dumps(heal_files))
                env.write_file(f"{work}/apply-heal-files.py", textwrap.dedent("""\
                    import json
                    import pathlib
                    files = json.load(open("/var/tmp/heal-files.json"))
                    for path, body in files.items():
                        pathlib.Path(path).write_text(body)
                    """))
                _clone_log(work, "point the machine-config daemon at the clone render")
                for node in nodes:
                    env.run(
                        "scp " + " ".join(SSH_OPTS) + f" -i {shlex.quote(identity)} "
                        f"{shlex.quote(work + '/currentconfig.json')} {shlex.quote(work + '/heal-files.json')} "
                        f"{shlex.quote(work + '/apply-heal-files.py')} "
                        f"core@{node['ip']}:/var/tmp/")
                    _vm(node["ip"],
                        "sudo cp /var/tmp/currentconfig.json /etc/machine-config-daemon/currentconfig && "
                        "sudo restorecon /etc/machine-config-daemon/currentconfig || true && "
                        "sudo python3 /var/tmp/apply-heal-files.py",
                        identity, check=False)
                node_names = " ".join(shlex.quote(node["role"]) for node in nodes)
                env.run(
                    f"{clone_oc} annotate node {node_names} "
                    f"machineconfiguration.openshift.io/desiredConfig={shlex.quote(rendered)} "
                    f"machineconfiguration.openshift.io/currentConfig={shlex.quote(rendered)} "
                    "machineconfiguration.openshift.io/state=Done --overwrite",
                    check=False)
                env.run(f"{clone_oc} adm uncordon {node_names}", check=False)
        identity_domains = compact_identity_domain_patches(clone_id)
        env.run(
            f"{clone_oc} patch dns.config.openshift.io cluster --type=merge "
            f"-p {shlex.quote(json.dumps(identity_domains['dns']))}",
            check=False)
        _clone_log(work, "set ingress spec.domain to the clone apps domain")
        compact_apply_clone_ingress_domain(clone_oc, clone_id, work)
        _sync_ingress_wildcard(clone_oc, clone_id, work)
        _ensure_api_certificates(clone_oc, work, domain, api_vip, nodes, identity)
        for node in nodes:
            _vm(node["ip"], "sudo podman rm -f etcd-proxy >/dev/null 2>&1 || true; sudo systemctl stop chrony-wait.service || true; sudo systemctl restart crio", identity, check=False)
            _vm(node["ip"], compact_release_keepalived_script(), identity, check=False)
            _vm(node["ip"], "sudo systemctl restart kubelet", identity, check=False)
        _refresh_internal_api_certificate(clone_oc, work, domain, api_vip, nodes, identity)

    _clone_log(work, "wait for three Ready nodes, an etcd leader, and green operators")
    deadline = time.time() + 40 * 60
    last = None
    last_auth = "unchecked"
    last_domains = "unchecked"
    while time.time() < deadline:
        for node in nodes:
            _vm(node["ip"],
                "systemctl is-active --quiet kubelet || sudo systemctl stop chrony-wait.service || true",
                identity, check=False)
        nodes_out = env.run(f"{clone_oc} get nodes --no-headers", check=False)
        co_out = env.run(f"{clone_oc} get co --no-headers", check=False)
        endpoints = ",".join(f"https://{node['ip']}:2379" for node in nodes)
        etcd_out = _vm(api_ip,
            "sudo podman run --rm --network host --privileged --authfile /var/lib/kubelet/config.json "
            "-v /etc/kubernetes/static-pod-resources/etcd-certs:/certs:ro "
            f"--entrypoint etcdctl {shlex.quote(etcd_image)} endpoint status "
            f"--endpoints={endpoints} "
            "--cacert /certs/configmaps/etcd-all-bundles/server-ca-bundle.crt "
            "--cert /certs/secrets/etcd-all-certs/etcd-peer-master-0-1.crt "
            "--key /certs/secrets/etcd-all-certs/etcd-peer-master-0-1.key -w json",
            identity, check=False)
        try:
            status = json.loads(etcd_out.stdout or "[]")
        except json.JSONDecodeError:
            status = []
        members = []
        for item in status:
            body = item.get("Status") or {}
            header = body.get("header") or {}
            members.append({
                "started": "error" not in item and bool(header.get("member_id")),
                "leader": header.get("member_id") is not None and header.get("member_id") == body.get("leader"),
            })
        health = compact_health(parse_oc_nodes(nodes_out.stdout or ""), members, parse_oc_co(co_out.stdout or ""))
        last = health
        admin_auth = compact_admin_auth_results(clone_kc, nodes)
        admin_failed = [item["role"] for item in admin_auth if not item["ok"]]
        operators_ready = health["ok"] or (
            health["ready"] == len(COMPACT_ROLES) and health["etcd_started"] == len(COMPACT_ROLES)
            and health["leader"] and health["unhealthy_operators"] == ["insights"]
        )
        sa_failed = []
        if operators_ready and not admin_failed:
            sa_auth = compact_serviceaccount_auth_results(clone_oc, nodes, work)
            sa_failed = [item["role"] for item in sa_auth if not item["ok"]]
            auth_ready = compact_auth_ready(admin_auth, sa_auth)
        else:
            auth_ready = False
        auth_detail = ",".join(admin_failed + [f"sa:{role}" for role in sa_failed]) or "ok"
        last_auth = auth_detail
        domains = compact_identity_domains(clone_oc)
        domains_ready = compact_identity_domains_ready(domains, clone_id)
        if not domains_ready:
            compact_apply_clone_ingress_domain(clone_oc, clone_id, work)
            domains = compact_identity_domains(clone_oc)
            domains_ready = compact_identity_domains_ready(domains, clone_id)
        if "console" in health["unhealthy_operators"] or "ingress" in health["unhealthy_operators"]:
            _sync_ingress_wildcard(clone_oc, clone_id, work)
        domain_detail = (
            f"dns={domains['base_domain'] or 'missing'} "
            f"ingress={domains['apps_domain'] or 'missing'}"
        )
        last_domains = domain_detail
        _clone_log(
            work,
            f"health ready={health['ready']} etcd={health['etcd_started']} leader={health['leader']} "
            f"unhealthy={','.join(health['unhealthy_operators']) or 'none'} auth={auth_detail} "
            f"{domain_detail}")
        if operators_ready and auth_ready and domains_ready:
            if health["unhealthy_operators"] == ["insights"]:
                _clone_log(
                    work,
                    f"Compact clone {clone_id} is up. insights is Degraded because the Red Hat "
                    f"upload token is rejected. Every other ClusterOperator is green. Log: {work}/clone.log")
            else:
                _clone_log(work, f"Compact clone {clone_id} is healthy. Log: {work}/clone.log")
            return health
        time.sleep(30)
    sys.exit(
        f"Clone did not become healthy within 40 minutes: {last} auth={last_auth} {last_domains}. "
        f"Log: {work}/clone.log")

def _start_compact_clone(source, clone_id, subnet, nodes, macs, identity, work, crypto, etcd_image, ingress_cn, memory_kib, vcpus, skip_hash_check=False):
    """Define the compact guests, restore etcd, and start the heal."""
    plan_path = "/out/summary.txt"
    by_role = {node["role"]: node for node in nodes}
    _clone_log(work, "define and start the clone network and VMs")
    plan = build_compact_boot_plan(
        source, clone_id, subnet, macs, f"{work}/snapshot.db", "/tmp/crypto", ingress_cn, plan_path)
    source_counts = {
        _compact_node_name(node): len(node.get("disks") or [])
        for node in source["nodes"]
    }
    for node in plan["nodes"]:
        count = source_counts.get(node["role"]) or 1
        node["disks"] = [
            compact_role_disk_dest(clone_id, node["role"], index)
            for index in range(count)
        ]
        node["disk"] = node["disks"][0]
        node["hostname"] = node["role"]
    emulator, machine_type = resolve_vm_platform()
    define_compact_libvirt(plan, emulator, machine_type, memory_kib, vcpus)
    env.run(f"virsh net-start {shlex.quote('test-infra-net-' + clone_id)}")
    for node in nodes:
        env.run(f"virsh start {shlex.quote(node['domain'])}")

    _clone_log(work, "wait for SSH and stop kubelet before etcd restore")
    for node in nodes:
        _wait_ssh(node["ip"], identity)
        _vm(node["ip"], compact_stop_workloads_script(), identity)
        _vm(node["ip"], "sudo systemctl stop chrony-wait.service || true", identity, check=False)

    _clone_log(work, "reissue etcd certificates for the clone IPs")
    reissue = compact_etcd_reissue_script(nodes, crypto, f"{work}/etcd-new")
    env.write_file(f"{work}/etcd-reissue.sh", reissue)
    env.run(f"chmod 700 {shlex.quote(work + '/etcd-reissue.sh')} && bash {shlex.quote(work + '/etcd-reissue.sh')}")
    env.run(f"chmod 700 {shlex.quote(work + '/etcd-new')} && chmod 600 {shlex.quote(work + '/etcd-new')}/* {shlex.quote(work + '/snapshot.db')}")

    pairs = compact_identity_pairs(source, clone_id, nodes)
    src_kc = f"{work}/source.kubeconfig"
    env.write_file(f"{work}/identity-pairs.json", json.dumps(pairs))
    env.write_file(f"{work}/rewrite-identity.py", compact_identity_script())
    restore_commands = compact_etcd_restore_commands(
        nodes, "/snapshot.db", clone_id, data_root="/restore", skip_hash_check=skip_hash_check)
    for node, restore in zip(nodes, restore_commands):
        _clone_log(work, f"restore etcd and rewrite files on {node['role']}")
        env.run(
            "scp " + " ".join(SSH_OPTS) + f" -i {shlex.quote(identity)} "
            f"{shlex.quote(work + '/snapshot.db')} {shlex.quote(work + '/identity-pairs.json')} "
            f"{shlex.quote(work + '/rewrite-identity.py')} {shlex.quote(work + '/etcd-new')}/etcd-*-{node['role']}.* "
            f"core@{node['ip']}:/var/tmp/")
        quoted = " ".join(shlex.quote(arg) for arg in restore["argv"][1:])
        _vm(node["ip"], " ".join([
            "sudo rm -rf /var/tmp/ct-restore && sudo mkdir -p /var/tmp/ct-restore",
            "&& sudo podman run --rm --network host --privileged",
            "--authfile /var/lib/kubelet/config.json",
            "-v /var/tmp/ct-restore:/restore",
            "-v /var/tmp/snapshot.db:/snapshot.db:ro",
            "--entrypoint etcdutl", shlex.quote(etcd_image),
            quoted,
        ]), identity)
        _vm(node["ip"], textwrap.dedent("""\
            set -euo pipefail
            sudo rm -rf /var/lib/etcd/member
            sudo mv /var/tmp/ct-restore/""" + node["role"] + """/member /var/lib/etcd/member
            sudo restorecon -R /var/lib/etcd/member || true
            sudo mkdir -p /var/tmp/etcd-install
            sudo find /etc/kubernetes/static-pod-resources -name etcd-all-certs -type d | while read -r dir; do
              sudo cp /var/tmp/etcd-peer-""" + node["role"] + """.crt "$dir"/ || true
              sudo cp /var/tmp/etcd-peer-""" + node["role"] + """.key "$dir"/ || true
              sudo cp /var/tmp/etcd-serving-""" + node["role"] + """.crt "$dir"/ || true
              sudo cp /var/tmp/etcd-serving-""" + node["role"] + """.key "$dir"/ || true
              sudo cp /var/tmp/etcd-serving-metrics-""" + node["role"] + """.crt "$dir"/ || true
              sudo cp /var/tmp/etcd-serving-metrics-""" + node["role"] + """.key "$dir"/ || true
            done
            sudo python3 /var/tmp/rewrite-identity.py
            """), identity)

    _clone_log(work, "copy every member certificate onto all three nodes")
    for node in nodes:
        for other in nodes:
            env.run(
                "scp " + " ".join(SSH_OPTS) + f" -i {shlex.quote(identity)} "
                f"{shlex.quote(work + '/etcd-new')}/etcd-*-{other['role']}.crt "
                f"{shlex.quote(work + '/etcd-new')}/etcd-*-{other['role']}.key "
                f"core@{node['ip']}:/var/tmp/")
        _vm(node["ip"], textwrap.dedent("""\
            set -euo pipefail
            sudo find /etc/kubernetes/static-pod-resources -name 'etcd-peer-*' -o -name 'etcd-serving-*' | while read -r existing; do
              base=$(basename "$existing")
              if [ -f "/var/tmp/$base" ]; then
                sudo cp "/var/tmp/$base" "$existing"
              fi
            done
            sudo restorecon -R /etc/kubernetes/static-pod-resources || true
            sudo systemctl start crio
            """), identity)
        _vm(node["ip"], compact_release_keepalived_script(), identity, check=False)
        _vm(node["ip"], "sudo systemctl start kubelet", identity)

    _clone_log(work, "wait for the clone API")
    api_ip = by_role[QUORUM_ETCD_ROLE]["ip"]
    ready = False
    for _ in range(90):
        probe = env.run(f"curl -sk --max-time 5 https://{api_ip}:6443/readyz || true", check=False)
        if probe.stdout.strip() == "ok":
            ready = True
            break
        time.sleep(10)
    if not ready:
        sys.exit(f"Clone API on {api_ip}:6443 did not become ready. Log: {work}/clone.log")

    return _finish_compact_clone(
        source, clone_id, nodes, identity, work, crypto, etcd_image, ingress_cn,
        plan_path, by_role, api_ip, src_kc, pairs)


RHCOS_ROOT_MOUNT = "/dev/sda4:/"
RHCOS_DEPLOYS = "/ostree/deploy/rhcos/deploy"
RHCOS_ETCD_DB = "/ostree/deploy/rhcos/var/lib/etcd/member/snap/db"
_rhcos_deploy_cache = {}


def choose_rhcos_deploy(names):
    """Choose the latest RHCOS deployment directory, ignoring origin files."""
    deploys = [name for name in names if name and not name.endswith(".origin")]
    if not deploys:
        sys.exit("No RHCOS deployment on the flavor disk")
    return sorted(deploys)[-1]


def _guest_run(disk, tool, guest_path, dest=""):
    """Run one guestfish command against an RHCOS disk."""
    command = f"{tool} -a {shlex.quote(disk)} -m {shlex.quote(RHCOS_ROOT_MOUNT)} {shlex.quote(guest_path)}"
    if dest:
        command += f" {shlex.quote(dest)}"
    return env.run(command, check=False)


def _rhcos_deploy(disk):
    """Return the RHCOS deployment directory on a flavor disk."""
    cached = _rhcos_deploy_cache.get(disk)
    if cached:
        return cached
    listing = _guest_run(disk, "virt-ls", RHCOS_DEPLOYS)
    if listing.returncode != 0:
        sys.exit(f"Could not list the RHCOS deployment on {disk}. {(listing.stderr or '').strip()}")
    deploy = f"{RHCOS_DEPLOYS}/{choose_rhcos_deploy(listing.stdout.split())}"
    _rhcos_deploy_cache[disk] = deploy
    return deploy


def _guest_cat(disk, path):
    """Read one file from an RHCOS disk."""
    guest_path = _rhcos_deploy(disk) + path
    r = _guest_run(disk, "virt-cat", guest_path)
    if r.returncode != 0:
        sys.exit(f"Could not read {path} from {disk}. {(r.stderr or '').strip()}")
    return r.stdout


def _guest_mac(disk):
    """Read the NetworkManager MAC from an RHCOS disk."""
    directory = _rhcos_deploy(disk) + "/etc/NetworkManager/system-connections"
    listing = _guest_run(disk, "virt-ls", directory)
    if listing.returncode != 0:
        sys.exit(f"Could not list NetworkManager connections on {disk}")
    for name in listing.stdout.split():
        mac = parse_nm_mac(_guest_cat(disk, f"/etc/NetworkManager/system-connections/{name}"))
        if mac:
            return mac
    sys.exit(f"No mac-address in NetworkManager connections on {disk}")


def _write_etcd_signers(snapshot, crypto):
    """Extract etcd signer material from a snapshot into the crypto directory."""
    script = textwrap.dedent("""\
        import pathlib, re, sys
        snapshot, crypto = sys.argv[1], sys.argv[2]
        data = pathlib.Path(snapshot).read_bytes()

        def pems_for(secret):
            marker = f"/kubernetes.io/secrets/openshift-etcd/{secret}".encode()
            start = data.find(marker)
            if start < 0:
                sys.exit(f"Etcd snapshot is missing {secret}")
            nxt = data.find(b"/kubernetes.io/secrets/", start + len(marker))
            window = data[start:nxt if nxt > 0 else start + 20000]
            return re.findall(
                rb"-----BEGIN [A-Z0-9 ]+-----.*?-----END [A-Z0-9 ]+-----",
                window, flags=re.S)

        for secret, stem in (("etcd-signer", "etcd-signer"), ("etcd-metric-signer", "etcd-metric-signer")):
            found = pems_for(secret)
            key = next((item for item in found if b"PRIVATE KEY" in item), None)
            certs = [item for item in found if b"CERTIFICATE" in item and b"PRIVATE" not in item]
            if not key or not certs:
                sys.exit(f"Etcd snapshot is missing {secret} key or certificate")
            out = pathlib.Path(crypto)
            (out / f"{stem}.key").write_bytes(key if key.endswith(b"\\n") else key + b"\\n")
            (out / f"{stem}.crt").write_bytes(certs[0] if certs[0].endswith(b"\\n") else certs[0] + b"\\n")
            (out / f"{stem}.key").chmod(0o600)
            (out / f"{stem}.crt").chmod(0o644)
        """)
    env.write_file(f"{crypto}/extract-etcd-signers.py", script)
    env.run(f"python3 {shlex.quote(crypto + '/extract-etcd-signers.py')} {shlex.quote(snapshot)} {shlex.quote(crypto)}")
    env.run(f"rm -f {shlex.quote(crypto + '/extract-etcd-signers.py')}")


def run_compact_from_flavor(flavor_name, flavor, clone_id, subnet, identity, memory_kib=None, vcpus=None, resume=None):
    """Deploy a compact cluster from a pulled flavor."""
    clone_id = _safe_clone_id(clone_id)
    if flavor.get("topology") != "compact":
        sys.exit(f"Flavor '{flavor_name}' is not a compact flavor")
    groups = compact_flavor_node_disks(flavor.get("disks") or [])
    for key in ("source_primary_subnet", "memory_kib", "vcpus", "etcd_image"):
        if flavor.get(key) in (None, ""):
            sys.exit(f"Flavor '{flavor_name}' is missing {key}")
    source_subnet = int(flavor["source_primary_subnet"])
    if subnet == source_subnet:
        sys.exit(f"Refusing to boot onto source subnet {subnet}.")
    work = f"/var/lib/libvirt/images/{clone_id}"
    exists = env.run(f"test -e {shlex.quote(work)} && echo yes || true")
    if resume == "recert":
        if "yes" not in exists.stdout:
            sys.exit(f"Nothing to resume at {work}.")
    elif "yes" in exists.stdout:
        sys.exit(f"{work} already exists. Remove that clone before running this one.")
    else:
        record_compact_clone(clone_id, subnet, flavor_name)
    fdir = flavor_dir(flavor_name)
    node_disks = []
    for _, os_name, spare_name in groups:
        paths = [f"{fdir}/{os_name}"]
        if spare_name:
            paths.append(f"{fdir}/{spare_name}")
        node_disks.append(paths)
    os_disks = [paths[0] for paths in node_disks]
    url_text = _guest_cat(os_disks[0], "/etc/kubernetes/apiserver-url.env")
    kubeconfig_text = _guest_cat(os_disks[0], "/etc/kubernetes/kubeconfig")
    bases = compact_dns_bases_from_text(url_text + "\n" + kubeconfig_text)
    if not bases:
        sys.exit("Could not find the source cluster domain on the flavor disk")
    macs = [_guest_mac(path) for path in os_disks]
    member_ips = compact_etcd_member_ips(
        _guest_cat(os_disks[0], "/etc/kubernetes/manifests/etcd-pod.yaml"))
    source = compact_source_from_layout(flavor, macs, bases, node_disks, node_ips=member_ips)
    env.run(f"mkdir -p {shlex.quote(work)} && chmod 755 {shlex.quote(work)}")
    _clone_log(work, f"read identity from flavor {flavor_name}")
    kubeconfig = _guest_cat(
        os_disks[0],
        "/etc/kubernetes/static-pod-resources/kube-apiserver-certs/secrets/node-kubeconfigs/lb-ext.kubeconfig")
    env.write_file(f"{work}/source.kubeconfig", kubeconfig)
    env.run(f"chmod 600 {shlex.quote(work + '/source.kubeconfig')}")
    nodes = compact_node_plan(clone_id, subnet, macs)
    for node in nodes:
        node["hostname"] = node["role"]
        node["disk"] = f"{work}/{node['role']}.qcow2"
    crypto = f"{work}/crypto"
    if resume == "recert":
        ingress_cn = env.run(f"cat {shlex.quote(crypto + '/ingress-cn.txt')}").stdout.strip()
        if not ingress_cn:
            sys.exit("Flavor crypto is missing ingress-cn.txt")
        if not identity:
            identity = f"{crypto}/cluster-tool.key"
        env.run(f"test -s {shlex.quote(identity)}")
        pairs = compact_identity_pairs(source, clone_id, nodes)
        by_role = {node["role"]: node for node in nodes}
        api_ip = by_role[QUORUM_ETCD_ROLE]["ip"]
        _clone_log(work, "resume at Recert")
        return _finish_compact_clone(
            source, clone_id, nodes, identity, work, crypto, flavor["etcd_image"], ingress_cn,
            "/out/summary.txt", by_role, api_ip, f"{work}/source.kubeconfig", pairs)
    flavor_crypto = flavor_crypto_dir(flavor_name)
    env.run(
        f"mkdir -p {shlex.quote(crypto)} && chmod 700 {shlex.quote(crypto)} && "
        f"cp -a {shlex.quote(flavor_crypto)}/. {shlex.quote(crypto)}/")
    ingress_cn = env.run(f"cat {shlex.quote(crypto + '/ingress-cn.txt')}").stdout.strip()
    if not ingress_cn:
        sys.exit("Flavor crypto is missing ingress-cn.txt")
    if not identity:
        identity = f"{crypto}/cluster-tool.key"
    env.run(f"test -s {shlex.quote(identity)}")
    env.run(f"chmod 600 {shlex.quote(identity)}")
    _clone_log(work, "copy the etcd database out of the flavor disk")
    env.run(f"mkdir -p {shlex.quote(work + '/snapshot-src')}")
    copied = env.run(
        f"guestfish --ro -a {shlex.quote(os_disks[1])} -m {shlex.quote(RHCOS_ROOT_MOUNT)} "
        f"copy-out {shlex.quote(RHCOS_ETCD_DB)} {shlex.quote(work + '/snapshot-src')}",
        check=False)
    if copied.returncode != 0:
        sys.exit(f"Could not copy the etcd database from {os_disks[1]}. {(copied.stderr or '').strip()}")
    env.run(
        f"mv {shlex.quote(work + '/snapshot-src/db')} {shlex.quote(work + '/snapshot.db')} && "
        f"rmdir {shlex.quote(work + '/snapshot-src')} && chmod 644 {shlex.quote(work + '/snapshot.db')}")
    _clone_log(work, "read etcd signer keys from the snapshot")
    _write_etcd_signers(f"{work}/snapshot.db", crypto)
    disk_count = sum(len(paths) for paths in node_disks)
    _clone_log(work, f"copy the {disk_count} flavor disks")
    for command in compact_copy_commands(compact_clone_disks(clone_id, source["nodes"])):
        env.run(command)
    memory_kib = memory_kib or flavor["memory_kib"]
    vcpus = vcpus or flavor["vcpus"]
    return _start_compact_clone(
        source, clone_id, subnet, nodes, macs, identity, work, crypto,
        flavor["etcd_image"], ingress_cn, memory_kib, vcpus, skip_hash_check=True)


