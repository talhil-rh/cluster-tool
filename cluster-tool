def rendered_machineconfig_files(raw):
    """Decode the ignition files stored in a rendered MachineConfig."""
    doc = json.loads(raw) if isinstance(raw, str) else raw
    files = {}
    for item in doc.get("spec", {}).get("config", {}).get("storage", {}).get("files") or []:
        path = item.get("path")
        source = (item.get("contents") or {}).get("source") or ""
        if not path or "," not in source:
            continue
        header, payload = source.split(",", 1)
        if "base64" in header:
            payload += "=" * ((4 - len(payload) % 4) % 4)
            try:
                body = base64.b64decode(payload).decode()
            except (UnicodeDecodeError, ValueError):
                continue
        else:
            body = urllib.parse.unquote(payload)
        files[path] = body
    return files
