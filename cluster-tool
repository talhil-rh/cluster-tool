    if name not in config["servers"]:
        sys.exit(f"Server '{name}' not found. Run './cluster-tool connect {name} --host ...' first.")
    return config["servers"][name]["host"]


def resolve_host_ip(hostname):
    try:
        addrs = socket.getaddrinfo(hostname, None)
    except socket.gaierror:
        sys.exit(f"Cannot resolve hostname '{hostname}'.")

    usable = []
    for addr in addrs:
        ip_str = addr[4][0]
        if addr[0] == socket.AF_INET6:
            try:
                if ipaddress.IPv6Address(ip_str).is_link_local:
                    continue
            except ValueError:
                sys.exit(f"Cannot parse IPv6 address '{ip_str}' from hostname '{hostname}'.")
        usable.append(ip_str)

    ipv4 = [ip for ip in usable if ":" not in ip]
    if ipv4:
        return ipv4[0]
    if usable:
        return usable[0]
    sys.exit(f"Cannot resolve hostname '{hostname}' to a usable (non-link-local) IP address.")

