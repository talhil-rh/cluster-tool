        server fallback 127.0.0.1:1 check

    frontend ingress-http
        bind *:80
        mode http
        default_backend ingress-http-fallback

    backend ingress-http-fallback
        mode http
        server fallback 127.0.0.1:1 check
    """)


def gen_haproxy_additions(clone_id, subnet):
    ip = f"192.168.{subnet}.{VM_IP_SUFFIX}"
    domain = f"test-infra-cluster-{clone_id}.redhat.com"
    use_backends = {
        "api": f"    use_backend api-{clone_id} if {{ req_ssl_sni -m end {domain} }}",
        "ingress-https": f"    use_backend ingress-https-{clone_id} if {{ req_ssl_sni -m end {domain} }}",
        "ingress-http": f"    use_backend ingress-http-{clone_id} if {{ hdr_end(host) {domain} }}",
    }
    backends = (
        f"\nbackend api-{clone_id}\n"
        f"    server api {ip}:6443 check\n"
        f"\nbackend ingress-https-{clone_id}\n"
        f"    server ingress {ip}:443 check\n"
        f"\nbackend ingress-http-{clone_id}\n"
        f"    mode http\n"
        f"    server ingress {ip}:80 check\n"
    )
    return use_backends, backends


def gen_dnsmasq_conf(clone_id):
    domain = f"test-infra-cluster-{clone_id}.redhat.com"
    return f"address=/{domain}/{env.host_ip}\n"


def print_step(num, total, desc, status=""):
    if status:
        print(f"\r  [{num}/{total}] {desc:<40s} {status}")
    else:
        print(f"  [{num}/{total}] {desc:<40s}", end="", flush=True)


def destroy_vm(vm_name):
    r = env.run(f"virsh domstate {vm_name}", check=False)
    if r.returncode != 0:
        return
    if "shut off" not in r.stdout:
        env.run(f"virsh destroy {vm_name}")
    env.run(f"virsh undefine {vm_name}")
    for _ in range(30):
        r = env.run(f"virsh domstate {vm_name}", check=False)
        if r.returncode != 0:
            return
        time.sleep(1)
    print(f"WARNING: VM {vm_name} still present after 30s, proceeding anyway")


def _strip_haproxy_clone(config, clone_id):
    backend_names = {f"api-{clone_id}", f"ingress-https-{clone_id}", f"ingress-http-{clone_id}"}
    lines = config.split("\n")
    filtered = []
    skip_block = False
    for line in lines:
        if "use_backend" in line:
            parts = line.split()
            idx = parts.index("use_backend") if "use_backend" in parts else -1
            if idx >= 0 and idx + 1 < len(parts) and parts[idx + 1] in backend_names:
                continue
        if line.strip().startswith("backend "):
            name = line.strip().split()[1]
            if name in backend_names:
                skip_block = True
                continue
        if skip_block:
            if line.strip() and not line.strip().startswith("backend") and not line.strip().startswith("frontend"):
                continue
            skip_block = False
            if not line.strip():
                continue
        filtered.append(line)
    return "\n".join(filtered)


def add_haproxy_clone(clone_id, subnet):
    with locked_haproxy():
        use_backends, backends = gen_haproxy_additions(clone_id, subnet)
        result = env.run("cat /etc/haproxy/haproxy.cfg")
        config = _strip_haproxy_clone(result.stdout, clone_id)

        for key in ["api", "ingress-https", "ingress-http"]:
            marker = f"    default_backend {key}-"
            config = config.replace(marker, f"{use_backends[key]}\n\n{marker}", 1)

        config = config.rstrip() + "\n" + backends
        env.write_file("/etc/haproxy/haproxy.cfg", config)
        env.run("systemctl reload haproxy")


def remove_haproxy_clone(clone_id):
    with locked_haproxy():
        result = env.run("cat /etc/haproxy/haproxy.cfg")
        config = _strip_haproxy_clone(result.stdout, clone_id)
        env.write_file("/etc/haproxy/haproxy.cfg", config)
        env.run("systemctl reload haproxy")


def add_dns_entry(clone_id):
    conf = _dnsmasq_dir() / f"cluster-{clone_id}.conf"
    conf.write_text(gen_dnsmasq_conf(clone_id))
    _reload_dns()


def remove_dns_entry(clone_id):
    conf = _dnsmasq_dir() / f"cluster-{clone_id}.conf"
    conf.unlink(missing_ok=True)
    _reload_dns()


def verify_cluster_identity(vm_ip, expected_id, expected_domain, *, identity=None):
    kc = "/etc/kubernetes/static-pod-resources/kube-apiserver-certs/secrets/node-kubeconfigs/lb-ext.kubeconfig"
    r = env.run_vm(vm_ip,
        f"sudo oc --kubeconfig={kc} --insecure-skip-tls-verify "
        f"get infrastructure cluster "
        f'-o jsonpath="{{.status.apiServerURL}}"',
        identity=identity)
    api_url = r.stdout.strip()
    if expected_domain not in api_url:
        sys.exit(
            f"IDENTITY MISMATCH: apiServerURL is '{api_url}' but expected domain '{expected_domain}'. "
            f"Recert may have failed to update the infrastructure resource. "
            f"Aborting to prevent source cluster corruption."
        )


def cache_image(vm_ip, image, anchor_name):
    """Ensure `image` is present in the node's local podman store and anchor it
    with a stopped container so prune won't remove it. Skips the pull if the
    image is already local -- once credentials are stripped, a pull would fail
    even for an image already fully present, since podman still needs to
    fetch the manifest to verify it."""
    exists = env.run_vm(vm_ip, f"sudo podman image exists {image}", check=False)
    if exists.returncode != 0:
        env.run_vm(vm_ip, f"sudo podman pull {image}")
    env.run_vm(vm_ip, f"sudo podman create --replace --name {anchor_name} {image} true")


def cmd_snapshot(args):
    state = load_state()
    flavor_name = args.name
    source_id = args.source

    if flavor_name in state["flavors"]:
        sys.exit(f"Flavor '{flavor_name}' already exists. Delete it first with 'cluster-tool flavors --delete {flavor_name}'.")

    vm_name = f"test-infra-cluster-{source_id}-master-0"
    fdir = flavor_dir(flavor_name)
    crypto = flavor_crypto_dir(flavor_name)

    r = env.run(f"virsh dominfo {vm_name}")
    dominfo = parse_dominfo(r.stdout)

    r = env.run(f"virsh dumpxml {vm_name}")
    disks = parse_disk_paths(r.stdout, f"test-infra-cluster-{source_id}")

    r = env.run(f"virsh net-dumpxml test-infra-net-{source_id}")
    src_primary_subnet = parse_subnet(r.stdout)
    r = env.run(f"virsh net-dumpxml test-infra-secondary-network-{source_id}")
    src_secondary_subnet = parse_subnet(r.stdout)

    vm_ip = f"192.168.{src_primary_subnet}.{VM_IP_SUFFIX}"

    r = env.run(f"virsh domstate {vm_name}")
    vm_state = r.stdout.strip()
    if vm_state != "running":
        sys.exit(f"Source VM '{vm_name}' is '{vm_state}', expected 'running'")

    print(f"Creating snapshot flavor '{flavor_name}' from {vm_name}...")

    print_step(1, 11, "Detecting etcd image")
    etcd_r = env.run_vm(vm_ip,
        "sudo python3 -c \""
        "import yaml, json; "
        "d=yaml.safe_load(open('/etc/kubernetes/manifests/etcd-pod.yaml')); "
        "print(next(c['image'] for c in d['spec']['containers'] if c['name']=='etcd'))\"",
        check=False)
    etcd_image = etcd_r.stdout.strip() if etcd_r.returncode == 0 and etcd_r.stdout.strip() else ETCD_IMAGE
    print_step(1, 11, "Detecting etcd image", "done")

    print_step(2, 11, "Extracting crypto keys")
    node_kc = "/etc/kubernetes/static-pod-resources/kube-apiserver-certs/secrets/node-kubeconfigs/lb-ext.kubeconfig"
    temp_kc = f"/tmp/kubeconfig-{source_id}"
    env.run(f"ssh {' '.join(SSH_OPTS)} core@{vm_ip} 'sudo cat {node_kc}' > {temp_kc}")
    oc = f"KUBECONFIG={temp_kc} oc --insecure-skip-tls-verify --server=https://{vm_ip}:6443"
    env.run(f"mkdir -p {crypto}")
    for secret, ns, dest in [
        ("loadbalancer-serving-signer", "openshift-kube-apiserver-operator", "lb-signer.key"),
        ("localhost-serving-signer", "openshift-kube-apiserver-operator", "localhost-signer.key"),
        ("service-network-serving-signer", "openshift-kube-apiserver-operator", "service-network-signer.key"),
        ("router-ca", "openshift-ingress-operator", "ingress.key"),
    ]:
        env.run(f"{oc} extract secret/{secret} -n {ns} --keys=tls.key --to=- > {crypto}/{dest}")
    env.run(f"{oc} extract configmap/admin-kubeconfig-client-ca -n openshift-config --keys=ca-bundle.crt --to=- > {crypto}/admin-kubeconfig-client-ca.crt")
    ingress_cn = env.run(
        f"{oc} get secret/router-ca -n openshift-ingress-operator "
        f"-o jsonpath='{{.data.tls\\.crt}}' | base64 -d | openssl x509 -noout -subject | sed 's/subject=CN *= *//'")
    if not ingress_cn.stdout.strip():
        sys.exit("Failed to extract ingress operator CN")
    env.run(f"echo '{ingress_cn.stdout.strip()}' > {crypto}/ingress-cn.txt")
    env.run(f"rm -f {temp_kc}")
    print_step(2, 11, "Extracting crypto keys", "done")

    print_step(3, 11, "Injecting SSH key")
    pub_key = env.run("cat ~/.config/cluster-tool/cluster-tool.key.pub").stdout.strip()
    env.run_vm(vm_ip, f"echo '{pub_key}' | sudo tee -a /home/core/.ssh/authorized_keys > /dev/null")
    print_step(3, 11, "Injecting SSH key", "done")

    print_step(4, 11, "Copying SSH keypair to crypto")
    env.run(f"cp ~/.config/cluster-tool/cluster-tool.key {crypto}/cluster-tool.key")
    env.run(f"cp ~/.config/cluster-tool/cluster-tool.key.pub {crypto}/cluster-tool.key.pub")
    print_step(4, 11, "Copying SSH keypair to crypto", "done")

    print_step(5, 11, "Preparing etcd for clean boot")
    env.run_vm(vm_ip,
        "cd /etc/kubernetes/static-pod-resources && "
        "rev=$(ls -d etcd-pod-* 2>/dev/null | sed 's/etcd-pod-//' | sort -n | tail -1) && "
        "sudo rm -f etcd-certs/etcd-pod.yaml && "
        "sudo rm -rf etcd-certs/secrets/etcd-all-certs && "
        "sudo mkdir -p etcd-certs/secrets/etcd-all-certs && "
        "for f in etcd-pod-${rev}/secrets/etcd-all-certs/*; do "
        "  sudo ln \"$f\" \"etcd-certs/secrets/etcd-all-certs/$(basename $f)\"; "
        "done")
    print_step(5, 11, "Preparing etcd for clean boot", "done")

    print_step(6, 11, "Caching boot images")
    cache_image(vm_ip, RECERT_IMAGE, "cache-recert")
    nodeip_r = env.run_vm(vm_ip,
        "grep -oP 'quay\\.io/openshift-release-dev/ocp-v4\\.0-art-dev@sha256:[a-f0-9]+' "
        "/etc/systemd/system/nodeip-configuration.service | head -1",
        check=False)
    nodeip_image = nodeip_r.stdout.strip()
    if not nodeip_image:
        sys.exit("Failed to detect nodeip-configuration image from systemd unit")
    cache_image(vm_ip, nodeip_image, "cache-nodeip")
    # The standalone etcd container recert starts (cmd_boot, "Running
    # recert") pulls this image with --authfile /var/lib/kubelet/config.json
    # -- the golden snapshot's frozen copy of that file, which cmd_boot must
    # not overwrite out-of-band (MCO owns it; see
    # test_boot_pull_secret_not_written_to_node). Caching it here, like
    # RECERT_IMAGE and nodeip_image above, means that authfile is never
    # actually needed at boot time: the image is already present locally, so
    # podman's default --pull=missing behavior skips the network pull (and
    # the credential check) entirely, regardless of whether the pull secret
    # baked into the snapshot is still valid by the time this snapshot boots.
    cache_image(vm_ip, etcd_image, "cache-etcd")
    print_step(6, 11, "Caching boot images", "done")

    print_step(7, 11, "Pruning unused container images")
    env.run_vm(vm_ip,
        "sudo crictl ps -a --state exited -q 2>/dev/null | xargs -r sudo crictl rm && "
        "sudo crictl --timeout 120s rmi --prune && "
        "sudo podman image prune -a -f && "
        "sudo podman rm cache-recert cache-nodeip cache-etcd")
    print_step(7, 11, "Pruning unused container images", "done")

    print_step(8, 11, "Shutting down VM")
    env.run(f"virsh shutdown {vm_name}")
    for _ in range(150):
        r = env.run(f"virsh domstate {vm_name}")
        if "shut off" in r.stdout:
            break
        time.sleep(2)
    else:
        sys.exit("VM did not shut down in 5 minutes")
    print_step(8, 11, "Shutting down VM", "done")

    print_step(9, 11, "Creating directories")
    env.run(f"mkdir -p {fdir} {REMOTE_OVERLAYS}")
    print_step(9, 11, "Creating directories", "done")

    print_step(10, 11, f"Copying {len(disks)} disk(s)")
    for i, disk in enumerate(disks):
        dest = f"{fdir}/disk-{i}.qcow2"
        env.run(f"qemu-img convert -O qcow2 {disk['path']} {dest}")
        env.run(f"chown qemu:qemu {dest}")
    print_step(10, 11, f"Copying {len(disks)} disk(s)", "done")

    print_step(11, 11, "Restarting source VM")
    env.run(f"virsh start {vm_name}")
    print_step(11, 11, "Restarting source VM", "done")

    with locked_state() as state:
        state["flavors"][flavor_name] = {
            "source_cluster": source_id,
            "source_primary_subnet": src_primary_subnet,
            "source_secondary_subnet": src_secondary_subnet,
            "memory_kib": dominfo["memory_kib"],
            "vcpus": dominfo["vcpus"],
            "disks": [f"disk-{i}.qcow2" for i in range(len(disks))],
            "etcd_image": etcd_image,
            "created_at": datetime.now(timezone.utc).isoformat(),
        }
    print(f"\nFlavor '{flavor_name}' created at {fdir}")


def cmd_boot(args):
    with locked_state() as state:
        flavors = state["flavors"]
        if not flavors:
            sys.exit("No flavors available. Run 'cluster-tool snapshot --name NAME --source ID' first.")

        flavor_name = args.flavor
        if not flavor_name:
            flavor_name = max(flavors, key=lambda k: flavors[k]["created_at"])
        if flavor_name not in flavors:
            sys.exit(f"Flavor '{flavor_name}' not found. Available: {', '.join(flavors.keys())}")

        flavor = flavors[flavor_name]
        if flavor.get("topology") == "compact":
            refuse_compact_boot()
        source_id = flavor["source_cluster"]
        src_primary = flavor["source_primary_subnet"]
        src_secondary = flavor["source_secondary_subnet"]
        memory_kib = flavor["memory_kib"]
        vcpus = flavor["vcpus"]
        if args.vcpus is not None:
            vcpus = args.vcpus
        if args.memory_kib is not None:
            memory_kib = args.memory_kib
        if vcpus < 1:
            sys.exit("--vcpus must be at least 1")
        if memory_kib < 1:
            sys.exit("--memory-kib must be at least 1")
        etcd_image = flavor["etcd_image"]
        disk_names = flavor["disks"]
        fdir = flavor_dir(flavor_name)
        crypto = flavor_crypto_dir(flavor_name)

        clone_id = args.name or generate_clone_id()
        if clone_id in state["clones"]:
            sys.exit(f"Clone '{clone_id}' already exists.")

        subnet = allocate_subnet(state)
        state["clones"][clone_id] = {
            "flavor": flavor_name,
            "subnet_primary": subnet,
            "subnet_secondary": subnet + SUBNET_SECONDARY_OFFSET,
            "status": "booting",
            "created_at": datetime.now(timezone.utc).isoformat(),
        }

    subnet_sec = subnet + SUBNET_SECONDARY_OFFSET
    mac1, mac2 = generate_mac(), generate_mac()
    vm_ip = f"192.168.{subnet}.{VM_IP_SUFFIX}"
    vm_name = f"test-infra-cluster-{clone_id}-master-0"
    domain = f"test-infra-cluster-{clone_id}.redhat.com"
    key_path = f"{crypto}/cluster-tool.key"
    env.run(f"chmod 600 {key_path}", check=False)

    vm_emulator, vm_machine_type = resolve_vm_platform()

    total = 9
    print(f'Creating clone "{clone_id}"...')
    cleanup = []

    try:
        print_step(1, total, f"Creating {len(disk_names)} disk overlay(s)")
        overlays = []
        for disk_name in disk_names:
            overlay = f"{REMOTE_OVERLAYS}/{clone_id}-{disk_name}"
            env.run(f"qemu-img create -f qcow2 -b {fdir}/{disk_name} -F qcow2 {overlay}")
            env.run(f"chown qemu:qemu {overlay}")
            cleanup.append(("rm", overlay))
            overlays.append(overlay)
        print_step(1, total, f"Creating {len(disk_names)} disk overlay(s)", "done")

        print_step(2, total, f"Creating network 192.168.{subnet}.0/24")
        primary_xml = gen_primary_network_xml(clone_id, subnet, mac1)
        secondary_xml = gen_secondary_network_xml(clone_id, subnet, subnet_sec, mac2)
        env.write_file(f"/tmp/net-{clone_id}.xml", primary_xml)
        env.run(f"virsh net-define /tmp/net-{clone_id}.xml")
        cleanup.append(("net", f"test-infra-net-{clone_id}"))
        env.run(f"virsh net-start test-infra-net-{clone_id}")
        env.write_file(f"/tmp/snet-{clone_id}.xml", secondary_xml)
        env.run(f"virsh net-define /tmp/snet-{clone_id}.xml")
        cleanup.append(("net", f"test-infra-secondary-network-{clone_id}"))
        env.run(f"virsh net-start test-infra-secondary-network-{clone_id}")
        env.run(f"rm -f /tmp/net-{clone_id}.xml /tmp/snet-{clone_id}.xml")
        print_step(2, total, f"Creating network 192.168.{subnet}.0/24", "done")

        print_step(3, total, "Booting VM")
        vm_xml = gen_vm_xml(
            clone_id, overlays, mac1, mac2,
            memory_kib=memory_kib, vcpus=vcpus,
            machine_type=vm_machine_type, emulator=vm_emulator,
        )
        env.write_file(f"/tmp/vm-{clone_id}.xml", vm_xml)
        env.run(f"virsh define /tmp/vm-{clone_id}.xml")
        env.run(f"virsh start {vm_name}")
        cleanup.append(("vm", vm_name))
        env.run(f"rm -f /tmp/vm-{clone_id}.xml")
        print_step(3, total, "Booting VM", "done")

        print_step(4, total, "Waiting for SSH")
        for _ in range(60):
            if env.run_vm(vm_ip, "echo ready", check=False, identity=key_path).returncode == 0:
                break
            time.sleep(5)
        else:
            sys.exit("SSH not available after 5 minutes")
        print_step(4, total, "Waiting for SSH", "done")

        print_step(5, total, "Running recert")
        src_ip = f"192.168.{src_primary}.{VM_IP_SUFFIX}"
        src_sec_ip = f"192.168.{src_secondary}.{VM_IP_SUFFIX}"
        new_sec_ip = f"192.168.{subnet_sec}.{VM_IP_SUFFIX}"

        env.run_vm(vm_ip, "sudo systemctl stop kubelet", identity=key_path)
        time.sleep(5)
        env.run_vm(vm_ip, "sudo systemctl stop crio", identity=key_path)
        time.sleep(5)

        env.run(f"scp {' '.join(SSH_OPTS)} -i {key_path} -r {crypto} core@{vm_ip}:/tmp/crypto")
        ingress_cn = env.run(f"cat {crypto}/ingress-cn.txt").stdout.strip()

        env.run_vm(vm_ip,
            f"sudo podman run -d --name etcd-recert "
            f"--network host --privileged "
            f"--authfile /var/lib/kubelet/config.json "
            f"-v /var/lib/etcd:/store "
            f"--entrypoint etcd "
            f"{etcd_image} "
            f"--name editor --data-dir /store "
            f"--listen-client-urls http://localhost:2379 "
            f"--advertise-client-urls http://localhost:2379",
            identity=key_path)

        for _ in range(30):
            r = env.run_vm(vm_ip, "curl -sf http://localhost:2379/health 2>/dev/null", check=False, identity=key_path)
            if r.returncode == 0:
                break
            time.sleep(2)
        else:
            logs = env.run_vm(vm_ip, "sudo podman logs etcd-recert 2>&1 | tail -20", check=False, identity=key_path)
            sys.exit(f"Standalone etcd not healthy after 60s.\n{logs.stdout}")

        env.run_vm(vm_ip,
            f"sudo podman run --rm --name recert "
            f"--pull=missing "
            f"--network host --privileged "
            f"-v /etc/kubernetes:/etc/kubernetes "
            f"-v /var/lib/kubelet:/var/lib/kubelet "
            f"-v /etc/machine-config-daemon:/etc/machine-config-daemon "
            f"-v /etc/cni:/etc/cni "
            f"-v /tmp/crypto:/tmp/crypto:ro "
            f"{RECERT_IMAGE} "
            f"--etcd-endpoint localhost:2379 "
            f"--crypto-dir /etc/kubernetes "
            f"--crypto-dir /var/lib/kubelet "
            f"--crypto-dir /etc/machine-config-daemon "
            f"--crypto-dir /etc/cni "
            f"--cluster-customization-dir /etc/kubernetes "
            f"--cluster-customization-dir /var/lib/kubelet "
            f"--cluster-customization-dir /etc/machine-config-daemon "
            f"--use-key kube-apiserver-lb-signer:/tmp/crypto/lb-signer.key "
            f"--use-key kube-apiserver-localhost-signer:/tmp/crypto/localhost-signer.key "
            f"--use-key kube-apiserver-service-network-signer:/tmp/crypto/service-network-signer.key "
            f"--use-key {ingress_cn}:/tmp/crypto/ingress.key "
            f"--cluster-rename test-infra-cluster-{clone_id}:redhat.com "
            f"--hostname {vm_name} "
            f"--ip {vm_ip} "
            f"--cn-san-replace api.test-infra-cluster-{source_id}.redhat.com:api.{domain} "
            f"--cn-san-replace api-int.test-infra-cluster-{source_id}.redhat.com:api-int.{domain} "
            f"--cn-san-replace *.apps.test-infra-cluster-{source_id}.redhat.com:*.apps.{domain} "
            f"--cn-san-replace test-infra-cluster-{source_id}-master-0:{vm_name} "
            f"--cn-san-replace system:node:test-infra-cluster-{source_id}-master-0,system:node:{vm_name} "
            f"--cn-san-replace {src_ip}:{vm_ip} "
            f"--cn-san-replace {src_sec_ip}:{new_sec_ip} "
            f"--extend-expiration",
            identity=key_path)

        env.run_vm(vm_ip, "sudo podman stop etcd-recert && sudo podman rm etcd-recert", identity=key_path)

        node_fix = (
            f"import pathlib\n"
            f"pathlib.Path('/etc/default/sno_dnsmasq_configuration_overrides').write_text("
            f"'SNO_CLUSTER_NAME_OVERRIDE=test-infra-cluster-{clone_id}\\n"
            f"SNO_BASE_DOMAIN_OVERRIDE=redhat.com\\n"
            f"SNO_DNSMASQ_IP_OVERRIDE={vm_ip}\\n')\n"
            f"pathlib.Path('/etc/default/nodeip-configuration').write_text("
            f"'KUBELET_NODEIP_HINT=192.168.{subnet}.0\\n')\n"
            f"import subprocess, os\n"
            f"subprocess.run(['hostnamectl', 'set-hostname', '{vm_name}'], check=True)\n"
            f"import shutil\n"
            f"shutil.rmtree('/run/nodeip-configuration', ignore_errors=True)\n"
            f"for f in ['/etc/openvswitch/conf.db', '/etc/openvswitch/.conf.db.~lock~',\n"
            f"          '/etc/ovn/ovnsb_db.db', '/etc/ovn/ovnnb_db.db']:\n"
            f"    try: os.remove(f)\n"
            f"    except FileNotFoundError: pass\n"
            f"shutil.rmtree('/var/lib/ovn-ic/etc', ignore_errors=True)\n"
            f"subprocess.run(['systemctl', 'restart', 'openvswitch'], check=True)\n"
            f"subprocess.run(['systemctl', 'restart', 'nodeip-configuration'], check=True)\n"
            f"subprocess.run(['systemctl', 'daemon-reload'], check=True)\n"
            f"subprocess.run(['systemctl', 'restart', 'NetworkManager'], check=True)\n"
            f"subprocess.run(['systemctl', 'restart', 'dnsmasq'], check=True)\n"
        )
        fix_b64 = base64.b64encode(node_fix.encode()).decode()
        env.run_vm(vm_ip, f"echo {fix_b64} | base64 -d | sudo python3", identity=key_path)

        pull_secret_path = os.path.expanduser(args.pull_secret)
        if not os.path.isfile(pull_secret_path):
            sys.exit(f"Pull secret not found: {pull_secret_path}")

        env.run_vm(vm_ip, "sudo systemctl start crio", identity=key_path)
        time.sleep(3)
        env.run_vm(vm_ip, "sudo systemctl start kubelet", identity=key_path)
        print_step(5, total, "Running recert", "done")

        print_step(6, total, "Waiting for cluster health")
        for _ in range(120):
            r = env.run(f"curl -sk https://{vm_ip}:6443/healthz", check=False)
            if r.stdout.strip() == "ok":
                break
            time.sleep(5)
        else:
            sys.exit("Cluster not healthy after 10 minutes")

        ps_b64 = base64.b64encode(Path(pull_secret_path).read_bytes()).decode()
        kc_path = "/etc/kubernetes/static-pod-resources/kube-apiserver-certs/secrets/node-kubeconfigs/lb-ext.kubeconfig"
        oc_vm = f"sudo oc --kubeconfig={kc_path} --insecure-skip-tls-verify"
        env.run_vm(vm_ip,
            f"echo {ps_b64} | base64 -d > /tmp/ps.json && "
            f"{oc_vm} set data secret/pull-secret -n openshift-config "
            f"--from-file=.dockerconfigjson=/tmp/ps.json && "
            f"rm /tmp/ps.json",
            identity=key_path)

        print_step(6, total, "Waiting for cluster health", "done")

        print_step(7, total, "Configuring access")
        kubeconfig_path = KUBECONFIG_DIR / f"{clone_id}.kubeconfig"
        KUBECONFIG_DIR.mkdir(parents=True, exist_ok=True)
        _restore_ownership(KUBECONFIG_DIR)
        r = env.run_vm(vm_ip, "sudo cat /etc/kubernetes/static-pod-resources/kube-apiserver-certs/secrets/node-kubeconfigs/lb-ext.kubeconfig", identity=key_path)
        kubeconfig_path.write_text(r.stdout)
        _restore_ownership(kubeconfig_path)

        kc_content = kubeconfig_path.read_text()
        kc_content = kc_content.replace(f"https://{vm_ip}:6443", f"https://api.{domain}:6443")
        kubeconfig_path.write_text(kc_content)
        _restore_ownership(kubeconfig_path)
        cleanup.append(("kubeconfig", kubeconfig_path))

        add_haproxy_clone(clone_id, subnet)
        cleanup.append(("haproxy", clone_id))
        add_dns_entry(clone_id)
        cleanup.append(("dns", clone_id))
        print_step(7, total, "Configuring access", "done")

        print_step(8, total, "Waiting for operators")
        kc_path = "/etc/kubernetes/static-pod-resources/kube-apiserver-certs/secrets/node-kubeconfigs/lb-ext.kubeconfig"
        oc_vm = f"sudo oc --kubeconfig={kc_path} --insecure-skip-tls-verify"
        node_ready = False
        for attempt in range(360):
            r = env.run_vm(vm_ip, f"{oc_vm} get nodes -o json", check=False, identity=key_path)
            if r.returncode == 0:
                try:
                    nodes = json.loads(r.stdout)
                    for node in nodes["items"]:
                        conds = {c["type"]: c for c in node["status"]["conditions"]}
                        ready_cond = conds.get("Ready", {})
                        if ready_cond.get("status") == "True":
                            node_ready = True
                        elif attempt % 6 == 0:
                            reason = ready_cond.get("reason", "unknown")
                            message = ready_cond.get("message", "")[:200]
                            net_cond = conds.get("NetworkUnavailable", {})
                            net_msg = f", NetworkUnavailable={net_cond.get('status', '?')}" if net_cond else ""
                            print(f"\n    [{attempt*5}s] Node NotReady: reason={reason}{net_msg}")
                            if message:
                                print(f"           {message}")
                            diag = env.run_vm(vm_ip, "sudo crictl pods --state ready -q 2>/dev/null | wc -l", check=False, identity=key_path)
                            diag2 = env.run_vm(vm_ip, "sudo crictl pods -q 2>/dev/null | wc -l", check=False, identity=key_path)
                            print(f"           Pods: {diag.stdout.strip()} ready / {diag2.stdout.strip()} total")
                            ovn = env.run_vm(vm_ip, "sudo crictl pods --name ovnkube -o json 2>/dev/null | python3 -c \"import sys,json; pods=json.loads(sys.stdin.read()).get('items',[]); print('; '.join(f'{p[\\\"metadata\\\"][\\\"name\\\"]}={p[\\\"state\\\"]}' for p in pods))\" 2>/dev/null || echo 'cannot query'", check=False, identity=key_path)
                            print(f"           OVN-K: {ovn.stdout.strip()}")
                except (json.JSONDecodeError, KeyError):
                    if attempt % 6 == 0:
                        print(f"\n    [{attempt*5}s] Cannot parse node status")
            else:
                if attempt % 6 == 0:
                    print(f"\n    [{attempt*5}s] oc get nodes failed (rc={r.returncode})")
            if node_ready:
                break
            time.sleep(5)
        else:
            r = env.run_vm(vm_ip, f"{oc_vm} get nodes -o wide", check=False, identity=key_path)
            sys.exit(f"Node not Ready after 30 minutes.\n{r.stdout}\n{r.stderr}")
        last_unhealthy = []
        for attempt in range(120):
            r = env.run_vm(vm_ip, f"{oc_vm} get co -o json", check=False, identity=key_path)
            if r.returncode == 0:
                try:
                    cos = json.loads(r.stdout)
                    items = cos["items"]
                    if items:
                        last_unhealthy = []
                        for co in items:
                            name = co["metadata"]["name"]
                            conds = {c["type"]: c["status"] for c in co["status"]["conditions"]}
                            if conds.get("Available") != "True" or conds.get("Degraded") == "True" or conds.get("Progressing") == "True":
                                msg = next((c.get("message", "") for c in co["status"]["conditions"] if c["type"] == "Degraded" and c["status"] == "True"), "")
                                if not msg:
                                    msg = next((c.get("message", "") for c in co["status"]["conditions"] if c["type"] == "Progressing" and c["status"] == "True"), "")
                                if not msg:
                                    msg = next((c.get("message", "") for c in co["status"]["conditions"] if c["type"] == "Available" and c["status"] != "True"), "")
                                last_unhealthy.append(f"{name}: {msg[:120]}")
                        if not last_unhealthy:
                            break
                except json.JSONDecodeError:
                    pass
            time.sleep(10)
        else:
            detail = "\n".join(f"  - {u}" for u in last_unhealthy)
            sys.exit(f"Operators not healthy after 20 minutes.\nUnhealthy operators:\n{detail}")
        print_step(8, total, "Waiting for operators", f"done ({len(items)}/{len(items)})")

        print_step(9, total, "Verifying cluster identity")
        verify_cluster_identity(vm_ip, clone_id, domain, identity=key_path)
        print_step(9, total, "Verifying cluster identity", "done")

    except (SystemExit, subprocess.CalledProcessError) as e:
        if args.no_rollback:
            print(f"\nBoot failed. Clone preserved for debugging (--no-rollback).")
            print(f"  VM: {vm_name}")
            print(f"  SSH: ssh -o StrictHostKeyChecking=no -i {key_path} core@{vm_ip}")
            print(f"  Destroy manually: cluster-tool destroy {clone_id}")
        else:
            print(f"\nBoot failed, rolling back...")
            for kind, target in reversed(cleanup):
                if kind == "vm":
                    destroy_vm(target)
                elif kind == "net":
                    env.run(f"virsh net-destroy {target}", check=False)
                    env.run(f"virsh net-undefine {target}", check=False)
                elif kind == "rm":
                    env.run(f"rm -f {target}")
                elif kind == "kubeconfig":
                    target.unlink(missing_ok=True)
                elif kind == "haproxy":
                    remove_haproxy_clone(target)
                elif kind == "dns":
                    remove_dns_entry(target)
            with locked_state() as s:
                s["clones"].pop(clone_id, None)
            print("Rollback complete.")
        if isinstance(e, subprocess.CalledProcessError):
            sys.exit(f"Command failed: {e.cmd}\n{e.stderr or e.stdout or ''}")
        raise

    with locked_state() as state:
        state["clones"][clone_id] = {
            "flavor": flavor_name,
            "subnet_primary": subnet,
            "subnet_secondary": subnet_sec,
            "vm_name": vm_name,
            "overlay_disks": overlays,
            "mac_primary": mac1,
            "mac_secondary": mac2,
            "created_at": datetime.now(timezone.utc).isoformat(),
        }

    print(f'\nCluster "{clone_id}" ready!')
    print(f"  API:        https://api.{domain}:6443")
    print(f"  Console:    https://console-openshift-console.apps.{domain}")
    print(f"  Kubeconfig: {kubeconfig_path}")
    print(f"\nexport KUBECONFIG={kubeconfig_path}")


