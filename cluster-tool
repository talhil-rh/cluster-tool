def compact_node_plan(clone_id, subnet, macs):
    """Build the three compact node records for a clone subnet."""
    if len(macs) != len(COMPACT_ROLES):
        sys.exit(f"Compact clone needs {len(COMPACT_ROLES)} MAC addresses, got {len(macs)}")
    nodes = []
    for role, suffix, mac in zip(COMPACT_ROLES, COMPACT_NODE_SUFFIXES, macs):
        nodes.append({
            "role": role,
            "suffix": suffix,
            "mac": mac,
            "ip": f"192.168.{subnet}.{suffix}",
            "domain": f"test-infra-cluster-{clone_id}-{role}",
        })
    return nodes


def _compact_node_name(node):
    """Return the compact role name stored on a source node."""
    return node.get("role") or node["name"]


def compact_initial_cluster(nodes):
    """Build the etcd initial-cluster list for the clone nodes."""
    by_name = {_compact_node_name(node): node for node in nodes}
    if set(by_name) != set(COMPACT_ROLES):
        sys.exit(f"etcd restore needs members {', '.join(COMPACT_ROLES)}")
    return ",".join(
        f"{role}=https://{by_name[role]['ip']}:2380" for role in COMPACT_ROLES)


def compact_etcd_restore_commands(nodes, snapshot, cluster_token, data_root="/var/lib/etcd-restore", skip_hash_check=False):
    """Build one etcd restore command for each compact member."""
    if not snapshot:
        sys.exit("etcd restore needs a snapshot path")
    if not cluster_token:
        sys.exit("etcd restore needs a cluster token")
    initial_cluster = compact_initial_cluster(nodes)
    by_name = {_compact_node_name(node): node for node in nodes}
    commands = []
    for role in COMPACT_ROLES:
        node = by_name[role]
        peer = f"https://{node['ip']}:2380"
        argv = [
            "etcdutl", "snapshot", "restore", snapshot,
            "--data-dir", f"{data_root}/{role}",
            "--name", role,
            "--initial-cluster", initial_cluster,
            "--initial-advertise-peer-urls", peer,
            "--initial-cluster-token", cluster_token,
        ]
        if skip_hash_check:
            argv.append("--skip-hash-check")
        commands.append({"name": role, "ip": node["ip"], "argv": argv})
    return commands


